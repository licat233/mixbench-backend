server {
    listen 80;
    listen 443 ssl http2;
    server_name ${DEV_HOST};
    index index.php index.html index.htm default.php default.htm default.html;
    root /www/${DEV_HOST};

    #SSL-START SSL相关配置，请勿删除或修改下一行带注释的404规则
    #HTTP_TO_HTTPS_START
    # if ($server_port !~ 443) {
    #     rewrite ^(/.*)$ https://$host$1 permanent;
    # }
    #error_page 404/404.html;
    ssl_certificate /etc/nginx/ssl/${DEV_HOST}/server.pem;
    ssl_certificate_key /etc/nginx/ssl/${DEV_HOST}/server.key;
    ssl_protocols TLSv1.1 TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-RSA-AES128-GCM-SHA256:ECDHE:ECDH:AES:HIGH:!NULL:!aNULL:!MD5:!ADH:!RC4;
    ssl_prefer_server_ciphers on;
    # ssl_session_cache shared:SSL:5m;
    ssl_session_timeout 5m;
    #SSL-END

    #ERROR-PAGE-START  404配置，可以注释、删除或修改
    error_page 404 /www/common/404.html;
    #error_page 502 /502.html;
    #ERROR-PAGE-END

    # 请求头加入IP地址
    proxy_set_header X-Real_IP $remote_addr;
    # Socket.IO Support
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_http_version 1.1;

    #禁止访问的文件或目录
    location ~ ^/(\.user.ini|\.htaccess|\.git|\.svn|\.project|LICENSE|README.md) {
        return 404;
    }

    location ~ .*\.(gif|jpg|jpeg|png|bmp|swf)$ {
        expires 30d;
        error_log /dev/null;
        access_log /dev/null;
    }

    location ~ .*\.(js|css)?$ {
        expires 12h;
        error_log /dev/null;
        access_log /dev/null;
    }

    location /mysql {
        proxy_pass http://mysql_manage:80;
    }

    location /redis {
        proxy_pass http://redis_manage:80;
    }

    location /jaeger {
        proxy_pass http://jaeger:16686;
    }

    location /grafana {
        proxy_pass http://grafana:3000;
    }

    location /kibana {
        proxy_pass http://kibana:5601;
    }

    location /asynqmon {
        proxy_pass http://asynqmon:8080;
    }

    access_log  /var/log/nginx/${DEV_HOST}.log;
    error_log  /var/log/nginx/${DEV_HOST}.error.log;
}