server {
    listen 80;
    server_name redis.mixbench.net;
    index index.php index.html index.htm default.php default.htm default.html;
    root /www/${DEV_HOST};

    #ERROR-PAGE-START  404配置，可以注释、删除或修改
    error_page 404 /www/common/404.html;
    #error_page 502 /502.html;
    #ERROR-PAGE-END

    proxy_set_header Host $host;

    #禁止访问的文件或目录
    location ~ ^/(\.user.ini|\.htaccess|\.git|\.svn|\.project|LICENSE|README.md) {
        return 404;
    }

    location ~ .*\.(jpg|jpeg|gif|png|ico|css|pdf|ppt|txt|bmp|rtf|ttf|svg|js)$ {
        proxy_pass http://redis_manage:80;
        expires 30d;
        add_header Cache-Control public;
    }

    location / {
        proxy_pass http://redis_manage:80;
    }

    location ~ .*\.(gif|jpg|jpeg|png|bmp|swf)$ {
        expires 30d;
        error_log /dev/null;
        access_log /dev/null;
    }

    location ~ .*\.(js|css)?$ {
        expires 12h;
        error_log /dev/null;
        access_log /dev/null;
    }

    access_log  /var/log/nginx/redis.mixbench.net.log;
    error_log  /var/log/nginx/redis.mixbench.net.error.log;
}