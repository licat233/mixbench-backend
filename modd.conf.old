# ======================== admin start ========================
# rpc
services/v1/admin/rpc/**/*.go services/v1/admin/model/**/*.go common/**/*.go {
    prep: go build -o build/admin-rpc/admin-rpc -v services/v1/admin/rpc/admin.go
    daemon +sigkill: build/admin-rpc/admin-rpc -f services/v1/admin/rpc/etc/admin.yaml
}

# api
services/v1/admin/api/**/*.go services/v1/admin/model/**/*.go common/**/*.go {
    prep: go build -o build/admin-api/admin-api -v services/v1/admin/api/admin.go
    daemon +sigkill: build/admin-api/admin-api -f services/v1/admin/api/etc/admin.yaml -d services/v1/admin/api
}

# ======================== admin end ========================

