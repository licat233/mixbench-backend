# ======================== admin start ========================
# rpc
service/v1/admin/rpc/**/*.go {
    prep: go build -o build/admin-rpc/admin-rpc -v service/v1/admin/rpc/admin.go
    daemon +sigkill: build/admin-rpc/admin-rpc -f service/v1/admin/rpc/etc/admin.yaml
}

# api
service/v1/admin/api/**/*.go {
    prep: go build -o build/admin-api/admin-api -v service/v1/admin/api/admin.go
    daemon +sigkill: build/admin-api/admin-api -f service/v1/admin/api/etc/admin-api.yaml -root=service/v1/admin/api
}

# ======================== admin end ========================

# ======================== captcha start ========================
# rpc
service/v1/captcha/rpc/**/*.go {
    prep: go build -o build/captcha-rpc/captcha-rpc -v service/v1/captcha/rpc/captcha.go
    daemon +sigkill: build/captcha-rpc/captcha-rpc -f service/v1/captcha/rpc/etc/captcha.yaml
}

# api
service/v1/captcha/api/**/*.go {
    prep: go build -o build/captcha-api/captcha-api -v service/v1/captcha/api/captcha.go
    daemon +sigkill: build/captcha-api/captcha-api -f service/v1/captcha/api/etc/captcha-api.yaml -root=service/v1/captcha/api
}

# ======================== captcha end ========================

