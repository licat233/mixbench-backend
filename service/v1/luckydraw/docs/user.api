@server(
  group: user
  prefix: /v1/api/luckydraw/user
)
service luckydraw {

  @doc "添加用户名单 基础API"
  @handler AddUser
  post /(AddUserReq) returns(BaseResp)

  @doc "更新用户名单 基础API"
  @handler PutUser
  put /(PutUserReq) returns(BaseResp)

  @doc "获取用户名单 基础API"
  @handler GetUser
  get /(GetUserReq) returns(BaseResp)

  @doc "删除用户名单 基础API"
  @handler DelUser
  delete /(DelUserReq) returns(BaseResp)

  @doc "获取用户名单列表 基础API"
  @handler GetUserList
  get /list(GetUserListReq) returns(BaseResp)

  @doc "获取用户名单枚举列表 基础API"
  @handler GetUserEnums
  get /enums(GetUserEnumsReq) returns(BaseResp)

}

