  "definitions": {
    "BaseResp": {
      "type": "object",
      "properties": {
        "success": {
          "type": "boolean",
          "format": "boolean",
          "description": "【响应状态】"
        },
        "message": {
          "type": "string",
          "description": "【给予的提示信息】"
        },
        "data": {
          "type": "object",
          "description": "【选填】响应的业务数据"
        },
        "total": {
          "type": "integer",
          "format": "int64",
          "description": " 【选填】数据总个数"
        },
        "pageSize": {
          "type": "integer",
          "format": "int64",
          "description": " 【选填】单页数量"
        },
        "current": {
          "type": "integer",
          "format": "int64",
          "description": " 【选填】当前页码，current与antd前端对接"
        },
        "totalPage": {
          "type": "integer",
          "format": "int64",
          "description": " 【自己加上去的】总共有多少页，根据前端的pageSize来计算"
        },
        "errorCode": {
          "type": "integer",
          "format": "int32",
          "description": " 【选填】错误类型代码：400错误请求，401未授权，500服务器内部错误，200成功"
        },
        "errorMessage": {
          "type": "string",
          "description": " 【选填】向用户显示消息"
        },
        "traceMessage": {
          "type": "string",
          "description": " 【选填】调试错误信息，请勿在生产环境下使用，可有可无"
        },
        "showType": {
          "type": "integer",
          "format": "int32",
          "default": "2",
          "description": " 【选填】错误显示类型：0.不提示错误;1.警告信息提示；2.错误信息提示；4.通知提示；9.页面跳转"
        },
        "traceId": {
          "type": "string",
          "description": " 【选填】方便后端故障排除：唯一的请求ID"
        },
        "host": {
          "type": "string",
          "description": " 【选填】方便后端故障排除：当前访问服务器的主机"
        }
      },
      "title": "BaseResp",
      "required": [
        "success",
        "showType"
      ]
    },
    "goodluckReq": {
      "type": "object",
      "properties": {
        "activity_id": {
          "type": "integer",
          "format": "int64",
          "description": " 活动id，需要传入活动id，用于查询redis缓存"
        },
        "activity_uuid": {
          "type": "string",
          "description": "活动uuid"
        }
      },
      "title": "goodluckReq",
      "required": [
        "activity_id",
        "activity_uuid"
      ]
    },
    "identifyReq": {
      "type": "object",
      "properties": {
        "passport": {
          "type": "string",
          "description": "凭证"
        }
      },
      "title": "identifyReq",
      "required": [
        "passport"
      ]
    },
    "luckyListReq": {
      "type": "object",
      "properties": {
        "activity_uuid": {
          "type": "string",
          "description": "活动uuid"
        },
        "pageSize": {
          "type": "integer",
          "format": "int64",
          "default": "20",
          "description": "页面大小"
        },
        "current": {
          "type": "integer",
          "format": "int64",
          "default": "1",
          "description": "当前页码"
        }
      },
      "title": "luckyListReq",
      "required": [
        "activity_uuid",
        "pageSize",
        "current"
      ]
    },
    "prizesReq": {
      "type": "object",
      "properties": {
        "activity_uuid": {
          "type": "string",
          "description": "活动uuid，用于校验，id是否正确"
        }
      },
      "title": "prizesReq",
      "required": [
        "activity_uuid"
      ]
    },
    "searchReq": {
      "type": "object",
      "properties": {
        "keyword": {
          "type": "string",
          "description": "查询关键词"
        }
      },
      "title": "searchReq",
      "required": [
        "keyword"
      ]
    },
    "selectPrizesReq": {
      "type": "object",
      "properties": {
        "activity_id": {
          "type": "integer",
          "format": "int64",
          "description": " 活动id，需要传入活动id，用于查询redis缓存"
        },
        "activity_uuid": {
          "type": "string",
          "description": "活动uuid"
        },
        "lucky_uuid_list": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "中奖名单UUID"
        }
      },
      "title": "selectPrizesReq",
      "required": [
        "activity_id",
        "activity_uuid",
        "lucky_uuid_list"
      ]
    }
  },
  "securityDefinitions": {
    "apiKey": {
      "type": "apiKey",
      "description": "Enter JWT Bearer token **_only_**",
      "name": "Authorization",
      "in": "header"
    }
  },
  "security": [
    {
      "apiKey": []
    }
  ]
}
