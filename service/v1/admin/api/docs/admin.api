syntax = "v1"

import "types.api"
import "activity.api"
import "adminer.api"
import "lucker.api"
import "prize.api"
import "prize_grade.api"
import "prizes_pool.api"
import "project.api"
import "rbac.api"
import "user.api"
import "users_pool.api"
import "account.api"
import "upload.api"

//管理员登陆，可用账号、手机号、邮箱登录，(暂未实现验证码登录功能)
type loginReq {
	Passport  string `json:"passport"`
	Password  string `json:"password"`
	AutoLogin bool   `json:"autoLogin,default=false"`
	CaptchaId string `json:"captcha_id"` //验证码ID
	Solution  string `json:"solution"`   //验证码答案
}

type loginByEmailReq {
	Email     string `json:"email"`                   //邮箱地址
	AutoLogin bool   `json:"autoLogin,default=false"` //是否开启自动登录
	CaptchaId string `json:"captcha_id,optional"`     //验证码ID
	Solution  string `json:"solution"`                //验证码答案
}

type loginEmailCaptchaReq {
	Email     string `json:"email"`               //邮箱地址
	CaptchaId string `json:"captcha_id,optional"` //验证码ID
	Solution  string `json:"solution"`            //验证码答案
}

type registerEmailCaptchaReq {
	Email     string `json:"email"`               //邮箱地址
	CaptchaId string `json:"captcha_id,optional"` //验证码ID
	Solution  string `json:"solution"`            //验证码答案
}

type bindEmailCaptchaReq {
	Email     string `json:"email"`               //邮箱地址
	CaptchaId string `json:"captcha_id,optional"` //验证码ID
	Solution  string `json:"solution"`            //验证码答案
}

@server(
	prefix: /v1/api/admin
)
service admin-api {
	@doc "登录"
	@handler login
	post /login(loginReq) returns(BaseResp)
	
	@doc(
		summary: "邮箱登录"
		des: "注意几个问题：①不要给未注册的邮箱发送邮件，②给邮箱发送验证码需要通过图片验证"
	)
	@handler loginByEmail
	post /loginByEmail(loginByEmailReq) returns(BaseResp)
	
	@doc "给登录邮箱发送验证码"
	@handler loginEmailCaptcha
	post /loginEmailCaptcha(loginEmailCaptchaReq) returns(BaseResp)
	
	@doc "给注册邮箱发送验证码"
	@handler registerEmailCaptcha
	post /registerEmailCaptcha(registerEmailCaptchaReq) returns(BaseResp)
	
	@doc "给绑定邮箱发送验证码"
	@handler bindEmailCaptcha
	post /bindEmailCaptcha(bindEmailCaptchaReq) returns(BaseResp)
}

@server(
	jwt: JwtAuth
	middleware: JwtMiddleware
	prefix: /v1/api/admin
)
service admin-api {
	@doc "注销登录"
	@handler logout
	post /logout returns(BaseResp)
	
	@doc "获取当前用户信息"
	@handler currentUser
	post /currentUser returns(BaseResp)
}