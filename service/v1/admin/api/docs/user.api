syntax = "v1"

type User {
	Id        int64     `json:"id"`         // 表主键
	Uuid      string    `json:"uuid"`       // 唯一识别码
	Passport  string    `json:"passport"`   // 凭证，可以是手机号或者社交账号，一般是由客户填入
	Email     string    `json:"email"`      // 邮箱
	Phone     string    `json:"phone"`      // 手机号
	Name      string    `json:"name"`       // 用户名
	Address   string    `json:"address"`    // 收货地址
	Score     int64     `json:"score"`      // 积分
	Status    int64     `json:"status"`     // 状态:0未授权，1正常，2已冻结
	CreateAt  int64     `json:"create_at"`  // 创建时间
	UpdateAt  int64     `json:"update_at"`  // 更新时间
	IsDeleted int64     `json:"is_deleted"` // 是否已被删除
	DeleteAt  int64     `json:"delete_at"`  // 删除时间
}

type UserGetReq {
	Id int64 `form:"id"`
}

type UserAddReq {
	Passport  string    `json:"passport"`   // 凭证，可以是手机号或者社交账号，一般是由客户填入
	Email     string    `json:"email"`      // 邮箱
	Phone     string    `json:"phone"`      // 手机号
	Name      string    `json:"name"`       // 用户名
	Address   string    `json:"address"`    // 收货地址
	Score     int64     `json:"score"`      // 积分
	Status    int64     `json:"status"`     // 状态:0未授权，1正常，2已冻结
}

type UserPutReq {  
	Id        int64     `json:"id"`         // 表主键
	Uuid      string    `json:"uuid"`       // 唯一识别码
	Passport  string    `json:"passport"`   // 凭证，可以是手机号或者社交账号，一般是由客户填入
	Email     string    `json:"email"`      // 邮箱
	Phone     string    `json:"phone"`      // 手机号
	Name      string    `json:"name"`       // 用户名
	Address   string    `json:"address"`    // 收货地址
	Score     int64     `json:"score"`      // 积分
	Status    int64     `json:"status"`     // 状态:0未授权，1正常，2已冻结
}

type UserDelReq {
	Id int64 `json:"id"`
}

//通用页面数据请求
type UserListReq {
	PageSize int64  `form:"pageSize,optional,default=20,range=[1:1000]"` //页面大小
	Page     int64  `form:"current,optional,default=1,range=[1:]"`       //当前页码
	Keyword  string `form:"keyword,optional"`                            //关键词，可选
	//字段搜索
    Passport  string    `form:"passport,optional"`   // 凭证，可以是手机号或者社交账号，一般是由客户填入
	Email     string    `form:"email,optional"`      // 邮箱
	Phone     string    `form:"phone,optional"`      // 手机号
	Name      string    `form:"name,optional"`       // 用户名
	Address   string    `form:"address,optional"`    // 收货地址
	Score     int64     `form:"score,optional,default=-1"`      // 积分
	Status    int64     `form:"status,optional,default=-1"`     // 状态:0未授权，1正常，2已冻结
}

type UserDetailReq {
	Id  int64  `form:"id"`
}

type UserDetail {
	User      User         `json:"user"`
	UserActivities []UserActivity  `json:"user_activities"`
}

type UserDetails {
	UserDetails  []UserDetail  `json:"user_details"`
}

@server(
	jwt: JwtAuth
	group: user
	middleware: JwtMiddleware
    prefix: /v1/api/admin/user
)
service admin-api {	
	@doc "获取用户列表"
	@handler List
	get /list(UserListReq) returns(BaseResp)

    @doc "获取用户详情列表"
	@handler UserDetail
	get /detail(UserDetailReq) returns(BaseResp)

	@doc "获取用户详情列表"
	@handler UserDetails
	get /details(UserListReq) returns(BaseResp)

	@doc "获取用户信息"
	@handler info 
	get /(UserGetReq) returns(BaseResp)

    @doc "添加用户"
	@handler add 
	post /(UserAddReq) returns(BaseResp)

    @doc "编辑用户"
	@handler put 
	put /(UserPutReq) returns(BaseResp)

    @doc "删除用户"
	@handler del 
	delete /(UserDelReq) returns(BaseResp)

    @doc "枚举列表"
	@handler enumList
	get /enumList returns([]Enum)
}

