syntax = "v1"

type GoodsTag {
    Id        int64     `json:"id"`         // 表主键
    Uuid      string    `json:"uuid"`       // 唯一识别码
    Name      string    `json:"name"`       // 名称
    Status    int64     `json:"status"`     // 状态:0不可用，1可用
    CreateAt  int64     `json:"create_at"`  // 创建时间
    UpdateAt  int64     `json:"update_at"`  // 更新时间
    IsDeleted int64     `json:"is_deleted"` // 是否已被删除
    DeleteAt  int64     `json:"delete_at"`  // 删除时间
}

type GoodsTagGetReq {
    Id        int64     `form:"id"`         // 表主键
}

type GoodsTagAddReq {
    Name      string    `json:"name"`       // 名称
    Status    int64     `json:"status"`     // 状态:0不可用，1可用
}

type GoodsTagPutReq {
    Id        int64     `json:"id"`         // 表主键
    Uuid      string    `json:"uuid"`       // 唯一识别码
    Name      string    `json:"name"`       // 名称
    Status    int64     `json:"status"`     // 状态:0不可用，1可用
}

type GoodsTagDelReq {
    Id int64 `json:"id"`
}


type GoodsTagListReq {
	PageSize int64  `form:"pageSize,optional,default=20,range=[1:1000]"` //页面大小
	Page     int64  `form:"current,optional,default=1,range=[1:]"`       //当前页码
	Keyword  string `form:"keyword,optional"`                            //关键词，可选
	//字段搜索
	Name      string    `form:"name,optional"`       // 名称
	Status    int64     `form:"status,optional,default=-1"`     // 是否可用
}

@server(
	jwt: JwtAuth
	group: goodsTag
	middleware: JwtMiddleware
    prefix: /v1/api/admin/goodsTag
)

service admin-api {
    @doc "获取商品标签列表"
	@handler GoodsTagList
	get /list(GoodsTagListReq) returns(BaseResp)

	@doc "获取商品标签信息"
	@handler GoodsTagInfo 
	get /(GoodsTagGetReq) returns(BaseResp)

    @doc "添加商品标签"
	@handler GoodsTagAdd 
	post /(GoodsTagAddReq) returns(BaseResp)

    @doc "编辑商品标签"
	@handler GoodsTagPut 
	put /(GoodsTagPutReq) returns(BaseResp)

    @doc "删除商品标签"
	@handler GoodsTagDel 
	delete /(GoodsTagDelReq) returns(BaseResp)
}

