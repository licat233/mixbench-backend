syntax = "v1"

type Adminer {
	Id           int64     `json:"id"`             // 表主键
	Uuid         string    `json:"uuid"`           // 唯一识别码
	Name         string    `json:"name"`           // 管理员名称
	Avatar       string    `json:"avatar"`         // 头像
	Passport     string    `json:"passport"`       // 账号
	Password     string    `json:"password"`       // 密码
	Email        string    `json:"email"`          // 邮箱
	Status       int64     `json:"status"`         // 账号状态，是否可用
	IsSuperAdmin int64     `json:"is_super_admin"` // 是否为超级管理员
	LoginCount   int64     `json:"login_count"`    // 登录次数
	LastLogin    int64     `json:"last_login"`     // 最后一次登录时间
	CreateAt     int64     `json:"create_at"`      // 创建时间
	UpdateAt     int64     `json:"update_at"`      // 更新时间
	IsDeleted    int64     `json:"is_deleted"`     // 是否已被删除
	DeleteAt     int64     `json:"delete_at"`      // 删除时间
}

type AdminerGetReq {
	Id int64 `form:"id"`
}

type AdminerAddReq {
	Name         string       `json:"name"`           // 管理员名称
	Avatar       string       `json:"avatar"`         // 头像
	Passport     string       `json:"passport"`       // 账号
	Password     string       `json:"password"`       // 密码
	Email        string       `json:"email"`          // 邮箱
	Status       int64        `json:"status,default=0"`  // 账号状态，是否可用
	IsSuperAdmin int64        `json:"is_super_admin,default=0"` // 是否为超级管理员
}

type AdminerPutReq {
	Id           int64        `json:"id"`             // 表主键
	Uuid         string       `json:"uuid"`           // 唯一识别码
	Name         string       `json:"name"`           // 管理员名称
	Avatar       string       `json:"avatar"`         // 头像
	Passport     string       `json:"passport"`          // 账号
	Password     string       `json:"password,optional"` // 密码
	Email        string       `json:"email"`             // 邮箱
	Status       int64        `json:"status,default=0"`  // 账号状态，是否可用
	IsSuperAdmin int64        `json:"is_super_admin,default=0"` // 是否为超级管理员
	LoginCount   int64        `json:"login_count,default=0"`  //登录次数
	LastLogin    int64        `json:"last_login,default=0"`  //最后一次登录时间
}

type AdminerDelReq {
	Id int64 `json:"id"`
}

type AdminerListReq {
	PageSize int64  `form:"pageSize,optional,default=20,range=[1:1000]"` //页面大小
	Page     int64  `form:"current,optional,default=1,range=[1:]"`       //当前页码
	Keyword  string `form:"keyword,optional"`                            //关键词，可选
	//字段搜索
	Name         string       `form:"name,optional"`           // 管理员名称
	Passport     string       `form:"passport,optional"`       // 账号
	Password     string       `form:"password,optional"`       // 密码
	Email        string       `form:"email,optional"`          // 邮箱
	Status       int64        `form:"status,optional,default=-1"`  // 账号状态，是否可用
	IsSuperAdmin int64        `form:"is_super_admin,optional,default=-1"` // 是否为超级管理员
	LoginCount   int64        `form:"login_count,optional,default=-1"`    // 登录次数
	LastLogin    int64        `form:"last_login,optional,default=-1"`     // 最后一次登录时间
}

@server(
	jwt: JwtAuth
	group: adminer
	middleware: JwtMiddleware,RbacMiddleware
    prefix: /v1/api/admin/adminer
)
service admin-api {
	@doc "获取管理员列表"
	@handler List
	get /list(AdminerListReq) returns(BaseResp)

	@doc "获取管理员信息"
	@handler info 
	get /(AdminerGetReq) returns(BaseResp)

    @doc "添加管理员"
	@handler add 
	post /(AdminerAddReq) returns(BaseResp)

    @doc "编辑管理员"
	@handler put 
	put /(AdminerPutReq) returns(BaseResp)

    @doc "删除管理员"
	@handler del 
	delete /(AdminerDelReq) returns(BaseResp)

    @doc "枚举列表"
	@handler enumList
	get /enumList returns([]Enum)
}
