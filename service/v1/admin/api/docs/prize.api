syntax = "v1"

type Prize {
	Id        int64     `json:"id"`         // 表主键
	Uuid      string    `json:"uuid"`       // 唯一识别码
	Name      string    `json:"name"`       // 奖品名称
	Image     string    `json:"image"`      // 奖品图片
	Price     float64   `json:"price"`      // 奖品价格
	Status    int64     `json:"status"`     // 是否可用
	CreateAt  int64     `json:"create_at"`  // 创建时间
	UpdateAt  int64     `json:"update_at"`  // 更新时间
	IsDeleted int64     `json:"is_deleted"` // 是否已被删除
	DeleteAt  int64     `json:"delete_at"`  // 删除时间
}

type PrizeGetReq {
	Id int64 `form:"id"`
}

type PrizeAddReq {
	Name      string    `json:"name"`       // 奖品名称
	Image     string    `json:"image"`      // 奖品图片
	Price     float64   `json:"price"`      // 奖品价格
	Status    int64     `json:"status"`     // 是否可用
}

type PrizePutReq {
	Id        int64     `json:"id"`         // 表主键
	Uuid      string    `json:"uuid"`       // 唯一识别码
	Name      string    `json:"name"`       // 奖品名称
	Image     string    `json:"image"`      // 奖品图片
	Price     float64   `json:"price"`      // 奖品价格
	Status    int64     `json:"status"`     // 是否可用
}

type PrizeDelReq {
	Id int64 `json:"id"`
}

//活动奖品信息
type ActivityPrize {
	Prize      Prize       `json:"prize"`        //奖品信息
	PrizesPool PrizesPool  `json:"prizes_pool"`  //奖品池信息
	PrizeGrade PrizeGrade  `json:"prize_grade"`  //奖品池信息
}

type ActivityPrizeListData {
	ActivityPrizeList []ActivityPrize  `json:"activity_prize_list"`        //活动奖品列表
}

type ActivityPrizesReq {
  ActivityId int64 `form:"activity_id,optional,default=-1"`  //所属活动id，-1表示无限制
}

type PrizeListReq {
	PageSize int64  `form:"pageSize,optional,default=20,range=[1:1000]"` //页面大小
	Page     int64  `form:"current,optional,default=1,range=[1:]"`       //当前页码
	Keyword  string `form:"keyword,optional"`                            //关键词，可选
	//字段搜索
	Name      string    `form:"name,optional"`       // 奖品名称
	Price     float64   `form:"price,optional,default=-1"`      // 奖品价格
	Status    int64     `form:"status,optional,default=-1"`     // 是否可用
}

@server(
	jwt: JwtAuth
	group: prize
	middleware: JwtMiddleware
    prefix: /v1/api/admin/prize
)
service admin-api {
	@doc "获取奖品列表"
	@handler List
	get /list(PrizeListReq) returns(BaseResp)

	@doc "获取奖品信息"
	@handler info 
	get /(PrizeGetReq) returns(BaseResp)

    @doc "添加奖品"
	@handler add 
	post /(PrizeAddReq) returns(BaseResp)

    @doc "编辑奖品"
	@handler put 
	put /(PrizePutReq) returns(BaseResp)

    @doc "删除奖品"
	@handler del 
	delete /(PrizeDelReq) returns(BaseResp)

    @doc "枚举列表"
	@handler enumList
	get /enumList returns([]Enum)

	@doc "获取某活动奖品池的奖品"
	@handler ActivityPrizes
	get /activityPrizes(ActivityPrizesReq) returns(BaseResp)
}