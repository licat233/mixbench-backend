syntax = "v1"

type PrizesPool {
	Id         int64     `json:"id"`          // 表主键
	Uuid       string    `json:"uuid"`        // 唯一识别码
	ActivityId int64     `json:"activity_id"` // 活动id
	PrizeId    int64     `json:"prize_id"`    // 奖品id
	LuckValue  int64     `json:"luck_value"`  // 幸运值
	Status     int64     `json:"status"`      // 是否可用，0不可用，1可用
	GradeId    int64     `json:"grade_id"`    // 等级id，如：一等奖
	Total      int64     `json:"total"`       // 奖品总数量
	Remainder  int64     `json:"remainder"`   // 奖品剩余数量
	CreateAt   int64     `json:"create_at"`   // 创建时间
	UpdateAt   int64     `json:"update_at"`   // 更新时间
	IsDeleted  int64     `json:"is_deleted"`  // 是否已被删除
	DeleteAt   int64     `json:"delete_at"`   // 删除时间
}

type PrizesPoolGetReq {
	Id int64 `form:"id"`
}

type PrizesPoolAddReq {
	ActivityId int64     `json:"activity_id"` // 活动id
	PrizeId    int64     `json:"prize_id"`    // 奖品id
	LuckValue  int64     `json:"luck_value"`  // 幸运值
	Status     int64     `json:"status"`      // 是否可用，0不可用，1可用
	GradeId    int64     `json:"grade_id"`    // 等级id，如：一等奖
	Total      int64     `json:"total"`       // 奖品总数量
	Remainder  int64     `json:"remainder"`   // 奖品剩余数量
}

type PrizesPoolPutReq {
	Id         int64     `json:"id"`          // 表主键
	Uuid       string    `json:"uuid"`        // 唯一识别码
	ActivityId int64     `json:"activity_id"` // 活动id
	PrizeId    int64     `json:"prize_id"`    // 奖品id
	LuckValue  int64     `json:"luck_value"`  // 幸运值
	Status     int64     `json:"status"`      // 是否可用，0不可用，1可用
	GradeId    int64     `json:"grade_id"`    // 等级id，如：一等奖
	Total      int64     `json:"total"`       // 奖品总数量
	Remainder  int64     `json:"remainder"`      // 奖品剩余数量
}

type PrizesPoolDelReq {
	Id int64 `json:"id"`
}

//通用页面数据请求
type PrizesPoolListReq {
	PageSize int64  `form:"pageSize,optional,default=20,range=[1:1000]"` //页面大小
	Page     int64  `form:"current,optional,default=1,range=[1:]"`       //当前页码
	Keyword  string `form:"keyword,optional"`                            //关键词，可选
	//字段搜索
	ActivityId int64     `form:"activity_id,optional,default=-1"` // 活动id
	PrizeId    int64     `form:"prize_id,optional,default=-1"`    // 奖品id
	LuckValue  int64     `form:"luck_value,optional,default=-1"`  // 幸运值
	Status     int64     `form:"status,optional,default=-1"`      // 是否可用，0不可用，1可用
	GradeId    int64     `form:"grade_id,optional,default=-1"`    // 等级id，如：一等奖
	Total      int64     `form:"total,optional,default=-1"`      // 奖品总数量
	Remainder  int64     `form:"remainder,optional,default=-1"`   // 奖品剩余数量
}

type ResetLuckValueReq {
	ActivityId    int64  `json:"activity_id"`              // 表主键
	ActivityUuid  string `json:"activity_uuid"`          // 保险起见，加入uuid做验证
}

@server(
	jwt: JwtAuth
	group: prizesPool
	middleware: JwtMiddleware
    prefix: /v1/api/admin/prizesPool
)
service admin-api {
	@doc "获取奖品池列表"
	@handler List
	get /list(PrizesPoolListReq) returns(BaseResp)

	@doc "获取奖品池信息"
	@handler info 
	get /(PrizesPoolGetReq) returns(BaseResp)

    @doc "添加奖品池"
	@handler add 
	post /(PrizesPoolAddReq) returns(BaseResp)

    @doc "编辑奖品池"
	@handler put 
	put /(PrizesPoolPutReq) returns(BaseResp)

    @doc "删除奖品池"
	@handler del 
	delete /(PrizesPoolDelReq) returns(BaseResp)

	@doc(
		summary: 重置某活动的奖品池概率
	)
	@handler ResetLuckValue
	post /resetLuckValue(ResetLuckValueReq) returns(BaseResp)
	
}
