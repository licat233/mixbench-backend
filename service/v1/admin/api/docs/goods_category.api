syntax = "v1"

type GoodsCategory {
    Id        int64     `json:"id"`         // 表主键
    Uuid      string    `json:"uuid"`       // 唯一识别码
    Name      string    `json:"name"`       // 名称
    Status    int64     `json:"status"`     // 状态:0下架，1上架，2预售
    CreateAt  int64     `json:"create_at"`  // 创建时间
    UpdateAt  int64     `json:"update_at"`  // 更新时间
    IsDeleted int64     `json:"is_deleted"` // 是否已被删除
    DeleteAt  int64     `json:"delete_at"`  // 删除时间
}

type GoodsCategoryGetReq {
    Id        int64     `form:"id"`         // 表主键
}

type GoodsCategoryAddReq {
    Name      string    `json:"name"`       // 名称
    Status    int64     `json:"status"`     // 状态:0下架，1上架，2预售
}

type GoodsCategoryPutReq {
    Id        int64     `json:"id"`         // 表主键
    Uuid      string    `json:"uuid"`       // 唯一识别码
    Name      string    `json:"name"`       // 名称
    Status    int64     `json:"status"`     // 状态:0下架，1上架，2预售
}

type GoodsCategoryDelReq {
    Id int64 `json:"id"`
}


type GoodsCategoryListReq {
	PageSize int64  `form:"pageSize,optional,default=20,range=[1:1000]"` //页面大小
	Page     int64  `form:"current,optional,default=1,range=[1:]"`       //当前页码
	Keyword  string `form:"keyword,optional"`                            //关键词，可选
	//字段搜索
	Name      string    `form:"name,optional"`       // 名称
	Status    int64     `form:"status,optional,default=-1"`     // 状态:0下架，1上架，2预售
}

@server(
	jwt: JwtAuth
	group: goodsCategory
	middleware: JwtMiddleware
    prefix: /v1/api/admin/goodsCategory
)

service admin-api {
	@doc "获取商品分类列表"
	@handler GoodsCategoryList
	get /list(GoodsCategoryListReq) returns(BaseResp)

	@doc "获取商品分类信息"
	@handler GoodsCategoryInfo 
	get /(GoodsCategoryGetReq) returns(BaseResp)

    @doc "添加商品分类"
	@handler GoodsCategoryAdd 
	post /(GoodsCategoryAddReq) returns(BaseResp)

    @doc "编辑商品分类"
	@handler GoodsCategoryPut 
	put /(GoodsCategoryPutReq) returns(BaseResp)

    @doc "删除商品分类"
	@handler GoodsCategoryDel 
	delete /(GoodsCategoryDelReq) returns(BaseResp)
}