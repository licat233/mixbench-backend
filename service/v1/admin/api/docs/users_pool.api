syntax = "v1"

type UserPool {
	Id         int64     `json:"id"`          // 表主键
	Uuid       string    `json:"uuid"`        // 唯一识别码
	ActivityId int64     `json:"activity_id"` // 活动id
	UserId     int64     `json:"user_id"`     // 奖品id
	Status     int64     `json:"status"`      // 状态:0未授权，1正常，2已冻结
	Score      int64     `json:"score"`       // 用户在当前活动的积分
	CreateAt   int64     `json:"create_at"`   // 创建时间
	UpdateAt   int64     `json:"update_at"`   // 更新时间
	IsDeleted  int64     `json:"is_deleted"`  // 是否已被删除
	DeleteAt   int64     `json:"delete_at"`   // 删除时间
}

type UserPoolGetReq {
	Id int64 `form:"id"`
}

type UserPoolAddReq {
	ActivityId int64     `json:"activity_id"` // 活动id
	UserId     int64     `json:"user_id"`     // 奖品id
	Status     int64     `json:"status"`      // 状态:0未授权，1正常，2已冻结
	Score      int64     `json:"score"`       // 用户在当前活动的积分
}

type UserPoolPutReq {  
	Id         int64     `json:"id"`          // 表主键
	Uuid       string    `json:"uuid"`        // 唯一识别码
	ActivityId int64     `json:"activity_id"` // 活动id
	UserId     int64     `json:"user_id"`     // 奖品id
	Status     int64     `json:"status"`      // 状态:0未授权，1正常，2已冻结
	Score      int64     `json:"score"`       // 用户在当前活动的积分
}

type UserPoolDelReq {
	Id int64 `json:"id"`
}

//通用页面数据请求
type UserPoolListReq {
	PageSize int64  `form:"pageSize,optional,default=20,range=[1:1000]"` //页面大小
	Page     int64  `form:"current,optional,default=1,range=[1:]"`       //当前页码
	Keyword  string `form:"keyword,optional"`                            //关键词，可选
	//字段搜索
	ActivityId int64     `form:"activity_id,optional,default=-1"` // 活动id
	UserId     int64     `form:"user_id,optional,default=-1"`     // 奖品id
	Status     int64     `form:"status,optional,default=-1"`      // 状态:0未授权，1正常，2已冻结
	Score      int64     `form:"score,optional,default=-1"`       // 用户在当前活动的积分
}

@server(
	jwt: JwtAuth
	group: usersPool
	middleware: JwtMiddleware
    prefix: /v1/api/admin/usersPool
)
service admin-api {	
	@doc "获取用户池列表"
	@handler UserPoolList
	get /list(UserPoolListReq) returns(BaseResp)

	@doc "获取用户池信息"
	@handler UserPoolInfo 
	get /(UserPoolGetReq) returns(BaseResp)

    @doc "添加用户池"
	@handler UserPoolAdd 
	post /(UserPoolAddReq) returns(BaseResp)

    @doc "编辑用户池"
	@handler UserPoolPut 
	put /(UserPoolPutReq) returns(BaseResp)

    @doc "删除用户池"
	@handler UserPoolDel 
	delete /(UserPoolDelReq) returns(BaseResp)
}

