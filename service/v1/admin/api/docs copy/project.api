syntax = "v1"

type Project {
	Id        int64     `json:"id"`         // 表主键
	Uuid      string    `json:"uuid"`       // 唯一识别码
	Name      string    `json:"name"`       // 项目名称
	Status    int64     `json:"status"`     // 项目状态
	CreateAt  int64     `json:"create_at"`  // 创建日期
	UpdateAt  int64     `json:"update_at"`  // 更新时间
	IsDeleted int64     `json:"is_deleted"` // 是否已被删除
	DeleteAt  int64     `json:"delete_at"`  // 删除时间
}

type ProjectGetReq {
	Id int64 `form:"id"`
}

type ProjectAddReq {
	Name       string       `json:"name"`        // 项目名称
	Status     int64        `json:"status,default=0"`      // 项目状态
}

type ProjectPutReq {  
	Id         int64        `json:"id"`          // 表主键
	Uuid       string       `json:"uuid"`        // 唯一识别码
	Name       string       `json:"name"`        // 项目名称
	Status     int64        `json:"status,default=0"`      // 项目状态
}

type ProjectDelReq {
	Id int64 `json:"id"`
}

type ProjectListReq {
	PageSize int64  `form:"pageSize,optional,default=20,range=[1:1000]"` //页面大小
	Page     int64  `form:"current,optional,default=1,range=[1:]"`       //当前页码
	Keyword  string `form:"keyword,optional"`                            //关键词，可选
	//字段搜索
	Name      string    `form:"name,optional"`       // 项目名称
	Status    int64     `form:"status,optional,default=-1"`     // 项目状态
}

type ProjectDtail {
	Project     Project   `json:"project"`
	Activities []Activity `json:"activities"`
}

type ProjectDetailReq {
  Id int64 `form:"id"`  //项目id
}


@server(
	jwt: JwtAuth
	group: project
	middleware: JwtMiddleware
    prefix: /v1/api/admin/project
)
service admin-api {	
	@doc "获取项目列表"
	@handler List
	get /list(ProjectListReq) returns(BaseResp)

	@doc "获取项目详细列表"
	@handler ProjectDetails
	get /projectDetails(ProjectListReq) returns(BaseResp)

	@doc "获取项目信息"
	@handler info 
	get /(ProjectGetReq) returns(BaseResp)

    @doc "添加项目"
	@handler add 
	post /(ProjectAddReq) returns(BaseResp)

    @doc "编辑项目"
	@handler put 
	put /(ProjectPutReq) returns(BaseResp)

    @doc "删除项目"
	@handler del 
	delete /(ProjectDelReq) returns(BaseResp)

    @doc "枚举列表"
	@handler enumList
	get /enumList returns([]Enum)

	@doc "获取项目详细"
	@handler ProjectDetail
	get /projectDetail(ProjectDetailReq) returns(BaseResp)

	@doc "获取项目树形枚举数据"
	@handler projectTreeOptions
	get /projectTreeOptions returns([]TreeOptions)
}

