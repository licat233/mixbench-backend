syntax = "v1"

//修改个人信息请求
type PutCurrentReq {
	Name     string `json:"name"`              // 管理员名称
	Avatar   string `json:"avatar"`            // 头像
	Passport string `json:"passport"`          // 账号
	Email    string `json:"email"`             // 邮箱
}

type VerifyPasswordReq {
	Password string `json:"password"` // 密码
}

type putPasswordReq {
	OldPassword string `json:"old_password"` // 旧密码
	NewPassword string `json:"new_password"` // 新密码
	//附加的验证码
	CaptchaId string `json:"captcha_id"` //验证码ID
	Solution  string `json:"solution"`   //验证码答案
}

@server(
	jwt: JwtAuth
	middleware: JwtMiddleware
	prefix: /v1/api/admin/account
    group: account
)
service admin-api {
    @doc "管理员校验自己的密码"
	@handler verifyPassword
	post /verifyPassword(VerifyPasswordReq) returns(BaseResp)
	
	@doc(
		summary: 管理员修改自己的账号信息，当修改密码时，需要提供验证码
	)
	@handler putCurrent
	post /putCurrent(PutCurrentReq) returns(BaseResp);

    @doc "获取自己的账号信息"
    @handler currentInfo
    get /currentInfo returns(BaseResp);

	@doc "修改自己的密码"
	@handler putPassword
	post /putPassword(putPasswordReq) returns(BaseResp);
}
