#命名空间 docker-compose项目名，会体现在容器名的前缀上
COMPOSE_PROJECT_NAME=mixbench-backend

# 设置时区
TZ=Asia/Shanghai
# 设置网络模式
NETWORKS_DRIVER=bridge

# 服务环境，dev-开发环境，test-测试环境，pre-预发环境，pro-正式环境
SERVICE_MODE=dev

# 是否是debug模式: true || false
SERVICE_DEBUG=true

# 域名
DOMAIN=mixbench.net

# 后端服务-域名
BACKEND_HOST=micro.mixbench.net

# 项目根目录
PROJECT_ROOT=/app
# 静态资源服务-域名
STATIC_HOST=static.mixbench.net
# 静态资源服务-根目录
STATIC_ROOT=/app/static

# 开发者面板服务
DEV_HOST=dev.mixbench.net

# 笔记：linux端口范围从1024到49151，它们松散地绑定于一些服务
# 内网 Nginx 对外http端口
NGINX_HTTP_PORT=11080
# 内网 Nginx 对外https端口
NGINX_HTTPS_PORT=11443

# 各服务的端口
ADMIN_API_PORT=7011
ADMIN_RPC_PORT=7012
CAPTCHA_API_PORT=7021
CAPTCHA_RPC_PORT=7022
LUCKDRAW_API_PORT=7031
LUCKDRAW_RPC_PORT=7032
LUCKDRAW_MQ_PORT=7033

# 各服务的prometheus端口
PROMETHEUS_ADMIN_API_PORT=4011
PROMETHEUS_ADMIN_RPC_PORT=4012
PROMETHEUS_CAPTCHA_API_PORT=4021
PROMETHEUS_CAPTCHA_RPC_PORT=4022
PROMETHEUS_LUCKDRAW_API_PORT=4031
PROMETHEUS_LUCKDRAW_RPC_PORT=4032
PROMETHEUS_LUCKDRAW_MQ_PORT=4033

# mysql配置
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE_PREFIX=mixbench
MYSQL_DATABASE=mixbench # 弃用
MYSQL_USERNAME=mixbench
MYSQL_PASSWORD=yI2~qF3iwY34
MYSQL_ROOT_PASSWORD=vU6|pR9&uW2$
MYSQL_CONN_OPTIONS=parseTime=True&charset=utf8mb4&collation=utf8mb4_0900_ai_ci&loc=Asia%2FShanghai

# redis配置
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# jwt配置
JWT_SECRET=lX0rC5kV3xR1qK8dS8dA6kI8

# Redis 可视化管理用户名称
REDIS_MANAGE_USERNAME=mixbench_redis
# Redis 可视化管理用户密码
REDIS_MANAGE_PASSWORD=qC3/bZ4~hP9!

# Kafka 可视化管理用户密码
KAFKA_MANAGE_PASSWORD=qC3x/bZ4fhP92

# ============= ELASTIC 配置 start =============
# elastic账号的密码 (至少六个字符)
ELASTIC_PASSWORD=zC4~rJ

# kibana_system账号的密码 (至少六个字符)，该账号仅用于一些kibana的内部设置，不能用来查询es
KIBANA_PASSWORD=zX8?jS

# Version of Elastic products
# STACK_VERSION=7.17.7
# STACK_VERSION=8.5.2 # 截止2022年12月6日，jaeger all in one暂不支持es v8
STACK_VERSION=7.13.4 # 新版本有兼容性问题，退回老一些的版本

# es容器的内存大小，请根据自己硬件情况调整(in bytes)
MEM_LIMIT=1073741824
# ============= ELASTIC 配置 end =============


# DTM #########################################
# DTM HTTP 协议端口号
DTM_HTTP_PORT=36789
# DTM gRPC 协议端口号
DTM_GRPC_PORT=36790
