#命名空间 docker-compose项目名，会体现在容器名的前缀上
COMPOSE_PROJECT_NAME=mixbench-backend

# 设置时区
TZ=Asia/Shanghai
# 设置网络模式
NETWORKS_DRIVER=bridge

# 服务环境，dev-开发环境，test-测试环境，pre-预发环境，pro-正式环境
# dev|test|rt|pre|pro
SERVICE_MODE=dev

# 域名
DOMAIN=mixbench.net

# 后端服务-域名
BACKEND_HOST=micro.mixbench.net

# 项目根目录
PROJECT_ROOT=/app
# 静态资源服务-域名
STATIC_HOST=static.mixbench.net
# 静态资源服务-根目录
STATIC_ROOT=/app/static

# 开发者面板服务
DEV_HOST=dev.mixbench.net

# ================ nginx 配置 ================

# 笔记：linux端口范围从1024到49151，它们松散地绑定于一些服务
# 内网 Nginx 对外http端口
NGINX_HTTP_PORT=11080
# 内网 Nginx 对外https端口
NGINX_HTTPS_PORT=11443
# 内网 Nginx 网关用户名
NGINX_USERNAME=licat
# 内网 Nginx 网关密码明文：licat233
# 使用 htpasswd 工具，加密命令：htpasswd -nb licat licat233
NGINX_PASSWORD='$apr1$WBCC0Vn6$rqyAkV6M/T4WLUxKfWj/71'

# ================ 业务服务 配置 ================

# 各业务服务的端口
ADMIN_API_PORT=7011
ADMIN_RPC_PORT=7012
AUTHENTICATION_API_PORT=7021
AUTHENTICATION_RPC_PORT=7022
AUTHENTICATION_MQ_PORT=7023
LUCKYDRAW_API_PORT=7031
LUCKYDRAW_RPC_PORT=7032
LUCKYDRAW_MQ_PORT=7033
CHAT_API_PORT=7041
CHAT_MQ_PORT=7043

# ================ prometheus 配置 ================

# 各服务的prometheus端口
PROMETHEUS_ADMIN_API_PORT=4011
PROMETHEUS_ADMIN_RPC_PORT=4012
PROMETHEUS_AUTHENTICATION_API_PORT=4021
PROMETHEUS_AUTHENTICATION_RPC_PORT=4022
PROMETHEUS_AUTHENTICATION_MQ_PORT=4023
PROMETHEUS_LUCKYDRAW_API_PORT=4031
PROMETHEUS_LUCKYDRAW_RPC_PORT=4032
PROMETHEUS_LUCKYDRAW_MQ_PORT=4033
PROMETHEUS_CHAT_API_PORT=4041

# ================ mysql 配置 ================

# mysql配置
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE_PREFIX=mixbench
MYSQL_DATABASE=mixbench # 弃用
MYSQL_USERNAME=mixbench
MYSQL_PASSWORD=yI2~qF3iwY34
MYSQL_ROOT_PASSWORD=vU6|pR9&uW2$
MYSQL_CONN_OPTIONS='parseTime=True&charset=utf8mb4&collation=utf8mb4_0900_ai_ci&loc=Asia%2FShanghai'

# ================ kafka 配置 ================

# kafka端口
KAFKA_PORT=9092

# ================ redis 配置 ================

# redis配置
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
AUTH_REDIS_DB=3   # auth 服务使用3号redis库

# ================ jwt 配置 ================

# jwt配置
JWT_SECRET=lX0rC5kV3xR1qK8dS8dA6kI8

# ================ redis 可视化 配置 ================

# Redis 可视化管理用户名称
REDIS_MANAGE_USERNAME=mixbench_redis
# Redis 可视化管理用户密码
REDIS_MANAGE_PASSWORD=qC3/bZ4~hP9!

# ================ Kafka 可视化 配置 ================

# Kafka 可视化管理用户密码
KAFKA_MANAGE_PASSWORD=qC3x/bZ4fhP92

# ============= ELASTIC 配置 start =============
# elastic账号的密码 (至少六个字符)
ELASTIC_PASSWORD=zC4~rJ

# kibana_system账号的密码 (至少六个字符)，该账号仅用于一些kibana的内部设置，不能用来查询es
KIBANA_PASSWORD=zX8?jS

# Version of Elastic products
# STACK_VERSION=7.17.7
# STACK_VERSION=8.5.2 # 截止2022年12月6日，jaeger all in one暂不支持es v8
STACK_VERSION=7.13.4 # 新版本有兼容性问题，退回老一些的版本

# es容器的内存大小，请根据自己硬件情况调整(in bytes)
MEM_LIMIT=1073741824
# ============= ELASTIC 配置 end =============


# DTM #########################################
