# 设置时区
TZ=Asia/Shanghai
# 设置网络模式
NETWORKS_DRIVER=bridge

# 服务环境，dev-开发环境，test-测试环境，pre-预发环境，pro-正式环境
SERVICE_MODE=dev

# 是否是debug模式: true || false
SERVICE_DEBUG=true

# 后端服务-域名
BACKEND_HOST=micro.mixbench.net

# 静态资源服务-域名
STATIC_HOST=static.mixbench.net
# 静态资源服务-根目录
STATIC_ROOT=./static

# 开发者面板服务
DEV_HOST=dev.mixbench.net

# 笔记：linux端口范围从1024到49151，它们松散地绑定于一些服务
# 内网 Nginx 对外端口
NGINX_PORT=11001

# 各服务的端口
ADMIN_API_PORT=7011
ADMIN_RPC_PORT=7012
CAPTCHA_API_PORT=7021
CAPTCHA_RPC_PORT=7022
LUCKDRAW_API_PORT=7031
LUCKDRAW_RPC_PORT=7032
LUCKDRAW_MQ_PORT=7033

# mysql配置
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=mixbench
MYSQL_USERNAME=mixbench
MYSQL_PASSWORD=yI2~qF3#wY3$
MYSQL_ROOT_PASSWORD=vU6|pR9&uW2$
MYSQL_CONN_OPTIONS=parseTime=True&charset=utf8mb4&collation=utf8mb4_0900_ai_ci&loc=Asia%2FShanghai

# redis配置
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# jwt配置
JWT_SECRET=lX0rC5kV3xR1qK8dS8dA6kI8

# Redis 可视化管理用户名称
REDIS_MANAGE_USERNAME=mixbench_redis
# Redis 可视化管理用户密码
REDIS_MANAGE_PASSWORD=qC3/bZ4~hP9!

# Kafka 可视化管理用户密码
KAFKA_MANAGE_PASSWORD=qC3x/bZ4fhP92

# elastic账号的密码 (至少六个字符)
ELASTIC_PASSWORD=zC4~rJ

# kibana_system账号的密码 (至少六个字符)，该账号仅用于一些kibana的内部设置，不能用来查询es
KIBANA_PASSWORD=zX8?jS

# es和kibana的版本，P.S：单机模式选7.17.7版本，集群模式选8.0+版本，
# STACK_VERSION=8.5.2
STACK_VERSION=7.17.7

# 集群名字
CLUSTER_NAME=mixbench-cluster

# x-pack安全设置，这里选择basic，基础设置，如果选择了trail，则会在30天后到期
LICENSE=basic
#LICENSE=trial

# es映射到宿主机的的端口
ES_PORT=9200

# kibana映射到宿主机的的端口
KIBANA_PORT=5601

# es容器的内存大小，请根据自己硬件情况调整
MEM_LIMIT=1073741824

# 命名空间，会体现在容器名的前缀上
COMPOSE_PROJECT_NAME=mixbench


# DTM #########################################
# DTM HTTP 协议端口号
DTM_HTTP_PORT=36789
# DTM gRPC 协议端口号
DTM_GRPC_PORT=36790
