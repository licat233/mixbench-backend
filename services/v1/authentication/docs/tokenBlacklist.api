@server(
  jwt: Auth
  group: tokenBlacklist
  middleware: AuthMiddleware,RbacMiddleware
  prefix: /v1/api/authentication/tokenBlacklist
)
service authentication {

  @doc "添加token黑名单 基础API"
  @handler AddTokenBlacklist
  post /(AddTokenBlacklistReq) returns(BaseResp)

  @doc "更新token黑名单 基础API"
  @handler PutTokenBlacklist
  put /(PutTokenBlacklistReq) returns(BaseResp)

  @doc "获取token黑名单 基础API"
  @handler GetTokenBlacklist
  get /(GetTokenBlacklistReq) returns(BaseResp)

  @doc "删除token黑名单 基础API"
  @handler DelTokenBlacklist
  delete /(DelTokenBlacklistReq) returns(BaseResp)

  @doc "获取token黑名单列表 基础API"
  @handler GetTokenBlacklistList
  get /list(GetTokenBlacklistListReq) returns(BaseResp)

  @doc "获取token黑名单枚举列表 基础API"
  @handler GetTokenBlacklistEnums
  get /enums(GetTokenBlacklistEnumsReq) returns(BaseResp)

}

