// The content in this block will not be updated
// 此区块内的内容不会被更新
//[custom service start]

@server(
  prefix: /v1/api/authentication
)
service authentication {
  @doc(
    summary: "预留的调试端口"
  )
  @handler test
  get /test(testReq) returns(BaseResp)

  @doc "jwt鉴权接口"
  @handler auth
  get /auth(AuthReq)
}

@server(
  group: captcha
  prefix: /v1/api/authentication/captcha
)
service authentication {
  @doc(
    summary: "获取数学验证码"
  )
  @handler GetMathCaptcha
  post /math(CaptchaReq) returns(BaseResp)

  @doc(
    summary: "验证码图片"
  )
  @handler ShowCaptchaImage
  get /show

  @doc(
    summary: "验证码校验"
  )
  @handler VerifyCaptcha
  post /process(ProcessCaptchaReq) returns(BaseResp)

  @doc(
    summary: "向邮箱发送验证码"
  )
  @handler SendEmailCaptcha
  post /email(EmailCaptchaReq) returns(BaseResp)

  @doc(
    summary: "邮箱验证码校验"
  )
  @handler VerifyEmailCaptcha
  post /email/process (EmailCaptchaVerifyReq) returns(EmailCaptchaResp)
}

//[custom service end]