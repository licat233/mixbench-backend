@server(
  group: campaign
  prefix: /v1/api/admin/campaign
)
service admin {

  @doc "添加活动 基础API"
  @handler AddCampaign
  post /(AddCampaignReq) returns(BaseResp)

  @doc "更新活动 基础API"
  @handler PutCampaign
  put /(PutCampaignReq) returns(BaseResp)

  @doc "获取活动 基础API"
  @handler GetCampaign
  get /(GetCampaignReq) returns(BaseResp)

  @doc "删除活动 基础API"
  @handler DelCampaign
  delete /(DelCampaignReq) returns(BaseResp)

  @doc "获取活动列表 基础API"
  @handler GetCampaignList
  get /list(GetCampaignListReq) returns(BaseResp)

  @doc "获取活动枚举列表 基础API"
  @handler GetCampaignEnums
  get /enums(GetCampaignEnumsReq) returns(BaseResp)

}

