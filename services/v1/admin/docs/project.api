//项目
type Project {
  Id int64 `json:"id"` //表主键
  Uuid string `json:"uuid"` //UUID
  Name string `json:"name"` //项目名称
  Status int64 `json:"status"` //项目状态: 0已下线，1已上线
}

//添加项目请求
type AddProjectReq {
  Name string `json:"name"` //项目名称
  Status int64 `json:"status"` //项目状态: 0已下线，1已上线
}

//更新项目请求
type PutProjectReq {
  Id int64 `json:"id"` //表主键
  Uuid string `json:"uuid"` //UUID
  Name string `json:"name"` //项目名称
  Status int64 `json:"status"` //项目状态: 0已下线，1已上线
}

//删除项目请求
type DelProjectReq {
  Id int64 `json:"id"` //项目 ID
}

//获取项目请求
type GetProjectReq {
  Id int64 `json:"id"` //项目 ID
}

//获取项目列表请求
type GetProjectListReq {
  PageSize int64 `form:"pageSize,optional,default=20"` //页面容量，默认20，可选
  Page int64 `form:"page,optional,default=1"` //当前页码，默认1，可选
  Current int64 `form:"current,optional,default=1"` //当前页码，默认1，用于对接umijs，可选
  Keyword string `form:"keyword,optional"` //关键词，可选
  Id int64 `form:"id,optional,default=-1"` //表主键
  Uuid string `form:"uuid,optional"` //UUID
  Name string `form:"name,optional"` //项目名称
  Status int64 `form:"status,optional,default=-1"` //项目状态: 0已下线，1已上线
}

//获取项目枚举请求
type GetProjectEnumsReq {
  ParentId int64 `json:"parentId,optional,default=-1"` //父级ID
}

// The content in this block will not be updated
// 此区块内的内容不会被更新
//[custom struct start]

//[custom struct end]

// ------------------------------ Struct End ------------------------------

@server(
  jwt: Auth
  group: project
  middleware: AuthMiddleware,RbacMiddleware
  prefix: /v1/api/admin/project
)
service admin {

  @doc "添加项目 基础API"
  @handler AddProject
  post /(AddProjectReq) returns(BaseResp)

  @doc "更新项目 基础API"
  @handler PutProject
  put /(PutProjectReq) returns(BaseResp)

  @doc "获取项目 基础API"
  @handler GetProject
  get /(GetProjectReq) returns(BaseResp)

  @doc "删除项目 基础API"
  @handler DelProject
  delete /(DelProjectReq) returns(BaseResp)

  @doc "获取项目列表 基础API"
  @handler GetProjectList
  get /list(GetProjectListReq) returns(BaseResp)

  @doc "获取项目枚举列表 基础API"
  @handler GetProjectEnums
  get /enums(GetProjectEnumsReq) returns(BaseResp)

}

