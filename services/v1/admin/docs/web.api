@server(
  group: web
  prefix: /v1/api/admin/web
)
service admin {

  @doc "添加网站 基础API"
  @handler AddWeb
  post /(AddWebReq) returns(BaseResp)

  @doc "更新网站 基础API"
  @handler PutWeb
  put /(PutWebReq) returns(BaseResp)

  @doc "获取网站 基础API"
  @handler GetWeb
  get /(GetWebReq) returns(BaseResp)

  @doc "删除网站 基础API"
  @handler DelWeb
  delete /(DelWebReq) returns(BaseResp)

  @doc "获取网站列表 基础API"
  @handler GetWebList
  get /list(GetWebListReq) returns(BaseResp)

  @doc "获取网站枚举列表 基础API"
  @handler GetWebEnums
  get /enums(GetWebEnumsReq) returns(BaseResp)

}

