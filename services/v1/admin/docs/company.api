//公司
type Company {
  Id int64 `json:"id"` //表主键
  Uuid string `json:"uuid"` //UUID
  Name string `json:"name"` //公司名称
  Status int64 `json:"status"` //项目状态: 0关闭，1开启
}

//添加公司请求
type AddCompanyReq {
  Name string `json:"name"` //公司名称
  Status int64 `json:"status"` //项目状态: 0关闭，1开启
}

//更新公司请求
type PutCompanyReq {
  Id int64 `json:"id"` //表主键
  Uuid string `json:"uuid"` //UUID
  Name string `json:"name"` //公司名称
  Status int64 `json:"status"` //项目状态: 0关闭，1开启
}

//删除公司请求
type DelCompanyReq {
  Id int64 `json:"id"` //公司 ID
}

//获取公司请求
type GetCompanyReq {
  Id int64 `json:"id"` //公司 ID
}

//获取公司列表请求
type GetCompanyListReq {
  PageSize int64 `form:"pageSize,optional,default=20"` //页面容量，默认20，可选
  Page int64 `form:"page,optional,default=1"` //当前页码，默认1，可选
  Current int64 `form:"current,optional,default=1"` //当前页码，默认1，用于对接umijs，可选
  Keyword string `form:"keyword,optional"` //关键词，可选
  Id int64 `form:"id,optional,default=-1"` //表主键
  Uuid string `form:"uuid,optional"` //UUID
  Name string `form:"name,optional"` //公司名称
  Status int64 `form:"status,optional,default=-1"` //项目状态: 0关闭，1开启
}

//获取公司枚举请求
type GetCompanyEnumsReq {
  ParentId int64 `json:"parentId,optional,default=-1"` //父级ID
}

// The content in this block will not be updated
// 此区块内的内容不会被更新
//[custom struct start]

//[custom struct end]

// ------------------------------ Struct End ------------------------------

@server(
  group: company
  prefix: /v1/api/admin/company
)
service admin {

  @doc "添加公司 基础API"
  @handler AddCompany
  post /(AddCompanyReq) returns(BaseResp)

  @doc "更新公司 基础API"
  @handler PutCompany
  put /(PutCompanyReq) returns(BaseResp)

  @doc "获取公司 基础API"
  @handler GetCompany
  get /(GetCompanyReq) returns(BaseResp)

  @doc "删除公司 基础API"
  @handler DelCompany
  delete /(DelCompanyReq) returns(BaseResp)

  @doc "获取公司列表 基础API"
  @handler GetCompanyList
  get /list(GetCompanyListReq) returns(BaseResp)

  @doc "获取公司枚举列表 基础API"
  @handler GetCompanyEnums
  get /enums(GetCompanyEnumsReq) returns(BaseResp)

}

