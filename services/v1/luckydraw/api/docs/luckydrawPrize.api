// ------------------------------ Struct Start ------------------------------

//---------奖品名单---------

//奖品名单
type Prize {
  Id int64 `json:"id"`  // 表主键
  Uuid string `json:"uuid"`  // 唯一识别码
  Name string `json:"name"`  // 奖品名称
  Image string `json:"image"`  // 奖品图片
  Price float64 `json:"price"`  // 奖品价格
  Status int64 `json:"status"`  // 是否可用
}

//添加奖品名单请求
type AddPrizeReq {
  Name string `json:"name"`  // 奖品名称
  Image string `json:"image"`  // 奖品图片
  Price float64 `json:"price"`  // 奖品价格
  Status int64 `json:"status"`  // 是否可用
}

//更新奖品名单请求
type PutPrizeReq {
  Id int64 `json:"id"`  // 表主键
  Uuid string `json:"uuid"`  // 唯一识别码
  Name string `json:"name"`  // 奖品名称
  Image string `json:"image"`  // 奖品图片
  Price float64 `json:"price"`  // 奖品价格
  Status int64 `json:"status"`  // 是否可用
}

//删除奖品名单请求
type DelPrizeReq {
  Id int64 `json:"id"`  // 奖品名单 ID
}

//获取奖品名单请求
type GetPrizeReq {
  Id int64 `form:"id"`  // 奖品名单 ID
}

//获取奖品名单列表请求
type GetPrizeListReq {
  PageSize int64 `form:"pageSize,optional,default=20"`  // 页面容量，默认20，可选
  Page int64 `form:"page,optional,default=1"`  // 当前页码，默认1，可选
  Current int64 `form:"current,optional,default=1"`  // 当前页码，默认1，用于对接umijs，可选
  Keyword string `form:"keyword,optional"`  // 关键词，可选
  Id int64 `form:"id,optional,default=-1"`  // 表主键
  Uuid string `form:"uuid,optional"`  // 唯一识别码
  Name string `form:"name,optional"`  // 奖品名称
  Image string `form:"image,optional"`  // 奖品图片
  Price float64 `form:"price,optional,default=-1"`  // 奖品价格
  Status int64 `form:"status,optional,default=-1"`  // 是否可用
}

//获取奖品名单枚举请求
type GetPrizeEnumsReq {
  ParentId int64 `form:"parentId,optional,default=-1"`  // 父级ID
}

// The content in this block will not be updated
// 此区块内的内容不会被更新
//[custom struct start]

//[custom struct end]

// ------------------------------ Service Start ------------------------------

// 奖品名单
@server(
  jwt: Auth
  group: prize
  middleware: AdminAuthMiddleware
  prefix: /v1/api/admin/luckydraw/prize
)
service luckydraw-api {

  @doc "添加奖品名单 基础API"
  @handler AddPrize
  post /(AddPrizeReq) returns (BaseResp)

  @doc "更新奖品名单 基础API"
  @handler PutPrize
  put /(PutPrizeReq) returns (BaseResp)

  @doc "获取奖品名单 基础API"
  @handler GetPrize
  get /(GetPrizeReq) returns (BaseResp)

  @doc "删除奖品名单 基础API"
  @handler DelPrize
  delete /(DelPrizeReq) returns (BaseResp)

  @doc "获取奖品名单列表 基础API"
  @handler GetPrizeList
  get /list(GetPrizeListReq) returns (BaseResp)

  @doc "获取奖品名单枚举列表 基础API"
  @handler GetPrizeEnums
  get /enums(GetPrizeEnumsReq) returns (BaseResp)

}

// The content in this block will not be updated
