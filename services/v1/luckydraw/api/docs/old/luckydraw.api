

// ------------------------------------ Struct ------------------------------------

//枚举项
type Enum {
  Label interface{} `json:"label"` //标签
  Value interface{} `json:"value"` //值
}

//枚举列表响应
type GetEnumsResp {
  Enums []Enum `json:"enums"` //enum列表
}

//普通选项
type Option {
  Title string `json:"title"` //标题
  Value int64 `json:"value"` //值
}

//普通选项列表
type Options {
  OptionList []Option `json:"option_list"` //普通选项列表数据
}

//树形选项
type TreeOption {
  Title string `json:"title"` //标题
  Value int64 `json:"value"` //值
  Children []TreeOption `json:"children,optional"` //子集
}

//树形选项列表
type TreeOptions {
  TreeOptionList []TreeOption `json:"tree_option_list"` //树形选项列表数据
}

//规范返回格式
type BaseResp {
  Status bool `json:"success"` //响应状态
  Message string `json:"message,optional"` //给予的提示信息
  Data interface{} `json:"data,optional"` //【选填】响应的业务数据
  Total int64 `json:"total,optional"` //【选填】数据总个数
  PageSize int64 `json:"page_size,optional"` //【选填】单页数量
  Page int64 `json:"current,optional"` //【选填】当前页码，current与antd前端对接
  TotalPage int64 `json:"total_page,optional"` //【选填】自增项，总共有多少页，根据前端的pageSize来计算
  ErrorCode int64 `json:"error_code,optional"` //【选填】错误类型代码：400错误请求，401未授权，500服务器内部错误，200成功
  ErrorMessage string `json:"error_message,optional"` //【选填】向用户显示消息
  TraceMessage string `json:"trace_message,optional"` //【选填】调试错误信息，请勿在生产环境下使用，可有可无
  ShowStruct int64 `json:"show_struct,optional"` //【选填】错误显示类型：0.不提示错误;1.警告信息提示；2.错误信息提示；4.通知提示；9.页面跳转
  TraceId string `json:"trace_id,optional"` //【选填】方便后端故障排除：唯一的请求ID
  Host string `json:"host,optional"` //【选填】方便后端故障排除：当前访问服务器的主机
}

//列表数据请求
type ListReq {
  PageSize int64 `form:"page_size,optional,default=20"` //页面容量，默认20，可选
  Page int64 `form:"page,optional,default=20"` //页码，默认20，可选
  Keyword int64 `form:"keyword,optional"` //关键词，可选
}

//通过ID请求
type ByIdReq {
  id int64 `form:"id"` //ID
}

//空请求
type NilReq {
}

//空响应
type NilResp {
}

//---------活动---------

//活动
type Activity {
  Id int64 `json:"id"` //表主键
  Uuid string `json:"uuid"` //唯一识别码
  Name string `json:"name"` //活动名称
  ProjectId int64 `json:"project_id"` //项目id
  Status int64 `json:"status"` //活动状态，是否在举办，默认关闭，需手动开启
  Pattern int64 `json:"pattern"` //方案: 0会员制，1公开制，2会员需授权
  MaxCount int64 `json:"max_count"` //最大抽奖次数：-1表示无限制，0表示不可抽奖
  MaxPrizes int64 `json:"max_prizes"` //最大抽奖次数：-1表示无限制，0表示不可中奖
  StartTime int64 `json:"start_time"` //活动开始时间
  EndTime int64 `json:"end_time"` //活动结束时间
  CreateAt int64 `json:"create_at"` //创建时间
  UpdateAt int64 `json:"update_at"` //更新时间
  IsDeleted int64 `json:"is_deleted"` //是否已被删除
  DeleteAt int64 `json:"delete_at"` //删除时间
}

//添加Activity请求
type AddActivityReq {
  Name string `json:"name"` //活动名称
  ProjectId int64 `json:"project_id"` //项目id
  Status int64 `json:"status"` //活动状态，是否在举办，默认关闭，需手动开启
  Pattern int64 `json:"pattern"` //方案: 0会员制，1公开制，2会员需授权
  MaxCount int64 `json:"max_count"` //最大抽奖次数：-1表示无限制，0表示不可抽奖
  MaxPrizes int64 `json:"max_prizes"` //最大抽奖次数：-1表示无限制，0表示不可中奖
  StartTime int64 `json:"start_time"` //活动开始时间
  EndTime int64 `json:"end_time"` //活动结束时间
}

//更新Activity请求
type PutActivityReq {
  Id int64 `json:"id"` //表主键
  Uuid string `json:"uuid"` //唯一识别码
  Name string `json:"name"` //活动名称
  ProjectId int64 `json:"project_id"` //项目id
  Status int64 `json:"status"` //活动状态，是否在举办，默认关闭，需手动开启
  Pattern int64 `json:"pattern"` //方案: 0会员制，1公开制，2会员需授权
  MaxCount int64 `json:"max_count"` //最大抽奖次数：-1表示无限制，0表示不可抽奖
  MaxPrizes int64 `json:"max_prizes"` //最大抽奖次数：-1表示无限制，0表示不可中奖
  StartTime int64 `json:"start_time"` //活动开始时间
  EndTime int64 `json:"end_time"` //活动结束时间
}

//删除Activity请求
type DelActivityReq {
  Id int64 `json:"id"` //Activity ID
}

//获取Activity请求
type GetActivityReq {
  Id int64 `json:"id"` //Activity ID
}

//获取Activity列表请求
type GetActivityListReq {
  PageSize int64 `form:"page_size,optional,default=20"` //页面容量，默认20，可选
  Page int64 `form:"page,optional,default=20"` //页码，默认20，可选
  Keyword int64 `form:"keyword,optional"` //关键词，可选
  Id int64 `form:"id,optional,default=-1"` //表主键
  Uuid string `form:"uuid,optional"` //唯一识别码
  Name string `form:"name,optional"` //活动名称
  ProjectId int64 `form:"project_id,optional,default=-1"` //项目id
  Status int64 `form:"status,optional,default=-1"` //活动状态，是否在举办，默认关闭，需手动开启
  Pattern int64 `form:"pattern,optional,default=-1"` //方案: 0会员制，1公开制，2会员需授权
  MaxCount int64 `form:"max_count,optional,default=-1"` //最大抽奖次数：-1表示无限制，0表示不可抽奖
  MaxPrizes int64 `form:"max_prizes,optional,default=-1"` //最大抽奖次数：-1表示无限制，0表示不可中奖
  StartTime int64 `form:"start_time,optional,default=-1"` //活动开始时间
  EndTime int64 `form:"end_time,optional,default=-1"` //活动结束时间
}

//获取Activity枚举请求
type GetActivityEnumsReq {
  ParentId int64 `json:",optional,default=-1"` //父级ID
}

//---------中奖名单---------

//中奖名单
