// 活动 基础API
@server(
  jwt: JwtAuth
  group: activity
  middleware: JwtMiddleware
  prefix: /v1/api/admin/activity
)
service luckydraw {

  @doc "添加Activity"
  @handler AddActivity
  post /(AddActivityReq) returns(AddActivityResp)

  @doc "更新Activity"
  @handler PutActivity
  put /(PutActivityReq) returns(PutActivityResp)

  @doc "获取Activity"
  @handler GetActivity
  get /(GetActivityReq) returns(GetActivityResp)

  @doc "删除Activity"
  @handler DelActivity
  delete /(DelActivityReq) returns(DelActivityResp)

  @doc "获取Activity列表"
  @handler GetActivityList
  get /list(GetActivityListReq) returns(GetActivityListResp)

  @doc "更新Activity枚举"
  @handler GetActivityEnums
  get /enums(GetActivityEnumsReq) returns(GetEnumsResp)

}

