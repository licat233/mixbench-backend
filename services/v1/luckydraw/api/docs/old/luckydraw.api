//---------活动用户池，可以参与该活动抽奖的用户，及其在该活动中的积分管理---------

//活动用户池，可以参与该活动抽奖的用户，及其在该活动中的积分管理
type UserPool {
  Id int64 `json:"id"` //表主键
  Uuid string `json:"uuid"` //唯一识别码
  ActivityId int64 `json:"activity_id"` //活动id
  UserId int64 `json:"user_id"` //用户id
  Status int64 `json:"status"` //状态:0未授权，1正常，2已冻结
  Score int64 `json:"score"` //用户在当前活动的积分
  CreateAt int64 `json:"create_at"` //创建时间
  UpdateAt int64 `json:"update_at"` //更新时间
  IsDeleted int64 `json:"is_deleted"` //是否已被删除
  DeleteAt int64 `json:"delete_at"` //删除时间
}

//添加UserPool请求
type AddUserPoolReq {
  ActivityId int64 `json:"activity_id"` //活动id
  UserId int64 `json:"user_id"` //用户id
  Status int64 `json:"status"` //状态:0未授权，1正常，2已冻结
  Score int64 `json:"score"` //用户在当前活动的积分
}

//更新UserPool请求
type PutUserPoolReq {
  Id int64 `json:"id"` //表主键
  Uuid string `json:"uuid"` //唯一识别码
  ActivityId int64 `json:"activity_id"` //活动id
  UserId int64 `json:"user_id"` //用户id
  Status int64 `json:"status"` //状态:0未授权，1正常，2已冻结
  Score int64 `json:"score"` //用户在当前活动的积分
}

//删除UserPool请求
type DelUserPoolReq {
  Id int64 `json:"id"` //UserPool ID
}

//获取UserPool请求
type GetUserPoolReq {
  Id int64 `json:"id"` //UserPool ID
}

//获取UserPool列表请求
type GetUserPoolListReq {
  PageSize int64 `form:"page_size,optional,default=20"` //页面容量，默认20，可选
  Page int64 `form:"page,optional,default=20"` //页码，默认20，可选
  Keyword int64 `form:"keyword,optional"` //关键词，可选
  Id int64 `form:"id,optional,default=-1"` //表主键
  Uuid string `form:"uuid,optional"` //唯一识别码
  ActivityId int64 `form:"activity_id,optional,default=-1"` //活动id
  UserId int64 `form:"user_id,optional,default=-1"` //用户id
  Status int64 `form:"status,optional,default=-1"` //状态:0未授权，1正常，2已冻结
  Score int64 `form:"score,optional,default=-1"` //用户在当前活动的积分
}

//获取UserPool枚举请求
type GetUserPoolEnumsReq {
  ParentId int64 `json:",optional,default=-1"` //父级ID
}


