// ------------------------------ Struct Start ------------------------------

//---------用户名单---------

//用户名单
type User {
  Id int64 `json:"id"`  // 表主键
  Uuid string `json:"uuid"`  // 唯一识别码
  Passport string `json:"passport"`  // 凭证，可以是手机号或者社交账号，一般是由客户填入
  Email string `json:"email"`  // 邮箱
  Phone string `json:"phone"`  // 手机号
  Name string `json:"name"`  // 用户名
  Address string `json:"address"`  // 收货地址
  Score int64 `json:"score"`  // 积分
  Status int64 `json:"status"`  // 状态:0未授权，1正常，2已冻结
}

//添加用户名单请求
type AddUserReq {
  Passport string `json:"passport"`  // 凭证，可以是手机号或者社交账号，一般是由客户填入
  Email string `json:"email"`  // 邮箱
  Phone string `json:"phone"`  // 手机号
  Name string `json:"name"`  // 用户名
  Address string `json:"address"`  // 收货地址
  Score int64 `json:"score"`  // 积分
  Status int64 `json:"status"`  // 状态:0未授权，1正常，2已冻结
}

//更新用户名单请求
type PutUserReq {
  Id int64 `json:"id"`  // 表主键
  Uuid string `json:"uuid"`  // 唯一识别码
  Passport string `json:"passport"`  // 凭证，可以是手机号或者社交账号，一般是由客户填入
  Email string `json:"email"`  // 邮箱
  Phone string `json:"phone"`  // 手机号
  Name string `json:"name"`  // 用户名
  Address string `json:"address"`  // 收货地址
  Score int64 `json:"score"`  // 积分
  Status int64 `json:"status"`  // 状态:0未授权，1正常，2已冻结
}

//删除用户名单请求
type DelUserReq {
  Id int64 `json:"id"`  // 用户名单 ID
}

//获取用户名单请求
type GetUserReq {
  Id int64 `form:"id"`  // 用户名单 ID
}

//获取用户名单列表请求
type GetUserListReq {
  PageSize int64 `form:"pageSize,optional,default=20"`  // 页面容量，默认20，可选
  Page int64 `form:"page,optional,default=1"`  // 当前页码，默认1，可选
  Current int64 `form:"current,optional,default=1"`  // 当前页码，默认1，用于对接umijs，可选
  Keyword string `form:"keyword,optional"`  // 关键词，可选
  Id int64 `form:"id,optional,default=-1"`  // 表主键
  Uuid string `form:"uuid,optional"`  // 唯一识别码
  Passport string `form:"passport,optional"`  // 凭证，可以是手机号或者社交账号，一般是由客户填入
  Email string `form:"email,optional"`  // 邮箱
  Phone string `form:"phone,optional"`  // 手机号
  Name string `form:"name,optional"`  // 用户名
  Address string `form:"address,optional"`  // 收货地址
  Score int64 `form:"score,optional,default=-1"`  // 积分
  Status int64 `form:"status,optional,default=-1"`  // 状态:0未授权，1正常，2已冻结
}

//获取用户名单枚举请求
type GetUserEnumsReq {
  ParentId int64 `form:"parentId,optional,default=-1"`  // 父级ID
}

// The content in this block will not be updated
// 此区块内的内容不会被更新
//[custom struct start]

//[custom struct end]

// ------------------------------ Service Start ------------------------------

// 用户名单
@server(
  jwt: Auth
  group: user
  middleware: AdminAuthMiddleware
  prefix: /v1/api/admin/luckydraw/user
)
service luckydraw-api {

  @doc "添加用户名单 基础API"
  @handler AddUser
  post /(AddUserReq) returns (BaseResp)

  @doc "更新用户名单 基础API"
  @handler PutUser
  put /(PutUserReq) returns (BaseResp)

  @doc "获取用户名单 基础API"
  @handler GetUser
  get /(GetUserReq) returns (BaseResp)

  @doc "删除用户名单 基础API"
  @handler DelUser
  delete /(DelUserReq) returns (BaseResp)

  @doc "获取用户名单列表 基础API"
  @handler GetUserList
  get /list(GetUserListReq) returns (BaseResp)

  @doc "获取用户名单枚举列表 基础API"
  @handler GetUserEnums
  get /enums(GetUserEnumsReq) returns (BaseResp)

}

