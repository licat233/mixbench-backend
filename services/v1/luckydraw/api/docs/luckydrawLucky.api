// ------------------------------ Struct Start ------------------------------

//---------中奖名单---------

//中奖名单
type Lucky {
  Id int64 `json:"id"`  // 表主键
  Uuid string `json:"uuid"`  // 唯一识别码
  UserId int64 `json:"userId"`  // 中奖用户id
  PrizePoolId int64 `json:"prizePoolId"`  // 所属奖品池id
  Status int64 `json:"status"`  // 状态: 0未领奖，1已领奖，2弃领
  LuckDate int64 `json:"luckDate"`  // 抽奖时间
  Ip string `json:"ip"`  // ip地址
}

//添加中奖名单请求
type AddLuckyReq {
  UserId int64 `json:"userId"`  // 中奖用户id
  PrizePoolId int64 `json:"prizePoolId"`  // 所属奖品池id
  Status int64 `json:"status"`  // 状态: 0未领奖，1已领奖，2弃领
  LuckDate int64 `json:"luckDate"`  // 抽奖时间
  Ip string `json:"ip"`  // ip地址
}

//更新中奖名单请求
type PutLuckyReq {
  Id int64 `json:"id"`  // 表主键
  Uuid string `json:"uuid"`  // 唯一识别码
  UserId int64 `json:"userId"`  // 中奖用户id
  PrizePoolId int64 `json:"prizePoolId"`  // 所属奖品池id
  Status int64 `json:"status"`  // 状态: 0未领奖，1已领奖，2弃领
  LuckDate int64 `json:"luckDate"`  // 抽奖时间
  Ip string `json:"ip"`  // ip地址
}

//删除中奖名单请求
type DelLuckyReq {
  Id int64 `json:"id"`  // 中奖名单 ID
}

//获取中奖名单请求
type GetLuckyReq {
  Id int64 `form:"id"`  // 中奖名单 ID
}

//获取中奖名单列表请求
type GetLuckyListReq {
  PageSize int64 `form:"pageSize,optional,default=20"`  // 页面容量，默认20，可选
  Page int64 `form:"page,optional,default=1"`  // 当前页码，默认1，可选
  Current int64 `form:"current,optional,default=1"`  // 当前页码，默认1，用于对接umijs，可选
  Keyword string `form:"keyword,optional"`  // 关键词，可选
  Id int64 `form:"id,optional,default=-1"`  // 表主键
  Uuid string `form:"uuid,optional"`  // 唯一识别码
  UserId int64 `form:"userId,optional,default=-1"`  // 中奖用户id
  PrizePoolId int64 `form:"prizePoolId,optional,default=-1"`  // 所属奖品池id
  Status int64 `form:"status,optional,default=-1"`  // 状态: 0未领奖，1已领奖，2弃领
  LuckDate int64 `form:"luckDate,optional,default=-1"`  // 抽奖时间
  Ip string `form:"ip,optional"`  // ip地址
}

//获取中奖名单枚举请求
type GetLuckyEnumsReq {
  ParentId int64 `form:"parentId,optional,default=-1"`  // 父级ID
}

// The content in this block will not be updated
// 此区块内的内容不会被更新
//[custom struct start]

//[custom struct end]

// ------------------------------ Service Start ------------------------------

// 中奖名单
@server(
  jwt: Auth
  group: lucky
  middleware: AdminAuthMiddleware
  prefix: /v1/api/admin/luckydraw/lucky
)
service luckydraw-api {

  @doc "添加中奖名单 基础API"
  @handler AddLucky
  post /(AddLuckyReq) returns (BaseResp)

  @doc "更新中奖名单 基础API"
  @handler PutLucky
  put /(PutLuckyReq) returns (BaseResp)

  @doc "获取中奖名单 基础API"
  @handler GetLucky
  get /(GetLuckyReq) returns (BaseResp)

  @doc "删除中奖名单 基础API"
  @handler DelLucky
  delete /(DelLuckyReq) returns (BaseResp)

  @doc "获取中奖名单列表 基础API"
  @handler GetLuckyList
  get /list(GetLuckyListReq) returns (BaseResp)

  @doc "获取中奖名单枚举列表 基础API"
  @handler GetLuckyEnums
  get /enums(GetLuckyEnumsReq) returns (BaseResp)

}

