//[custom service start]

@server(
  prefix: /v1/api/luckydraw
)
service luckydraw {
  // @doc "展现抽奖页面"
  // @handler luckView
  // get /:shortlink

  @doc "抽奖者身份验证"
  @handler UserIdentify
  post /userIdentify (UserIdentifyReq) returns(BaseResp)

  @doc "获取活动奖品列表"
  @handler ActivityPrizes
  post /activityPrizes (ActivityPrizesReq) returns(BaseResp)

  @doc(
    summary: '预留的调试端口'
  )
  @handler test
  get /test(testReq) returns(BaseResp)
}

@server(
  middleware: UserAuthMiddleware
  prefix: /v1/api/luckydraw
)
service luckydraw {
  @doc "获取自己在某活动的中奖名单"
  @handler GetALuckyList
  post /activityLuckyList (GetALuckyListReq) returns(BaseResp)

  @doc "抽取奖品"
  @handler luckydraw
  post /luckydraw (luckydrawReq) returns(BaseResp)

  @doc "查询中奖信息"
  @handler searchLucky
  post /searchLucky (searchLuckyReq) returns(BaseResp)

  @doc "挑选奖品"
  @handler selectPrizes
  post /selectPrizes (selectPrizesReq) returns(BaseResp)
}

//[custom service end]