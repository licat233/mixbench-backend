//活动
type Activity {
  Id int64 `json:"id"` //表主键
  Uuid string `json:"uuid"` //UUID
  Name string `json:"name"` //活动名称
  ProjectId int64 `json:"projectId"` //项目id
  Status int64 `json:"status"` //活动状态，是否在举办，默认关闭，需手动开启
  Pattern int64 `json:"pattern"` //方案: 0会员制，1公开制，2会员需授权
  MaxCount int64 `json:"maxCount"` //最大抽奖次数：-1表示无限制，0表示不可抽奖
  MaxPrizes int64 `json:"maxPrizes"` //最大抽奖次数：-1表示无限制，0表示不可中奖
  StartTime int64 `json:"startTime"` //活动开始时间
  EndTime int64 `json:"endTime"` //活动结束时间
}

//添加活动请求
type AddActivityReq {
  Name string `json:"name"` //活动名称
  ProjectId int64 `json:"projectId"` //项目id
  Status int64 `json:"status"` //活动状态，是否在举办，默认关闭，需手动开启
  Pattern int64 `json:"pattern"` //方案: 0会员制，1公开制，2会员需授权
  MaxCount int64 `json:"maxCount"` //最大抽奖次数：-1表示无限制，0表示不可抽奖
  MaxPrizes int64 `json:"maxPrizes"` //最大抽奖次数：-1表示无限制，0表示不可中奖
  StartTime int64 `json:"startTime"` //活动开始时间
  EndTime int64 `json:"endTime"` //活动结束时间
}

//更新活动请求
type PutActivityReq {
  Id int64 `json:"id"` //表主键
  Uuid string `json:"uuid"` //UUID
  Name string `json:"name"` //活动名称
  ProjectId int64 `json:"projectId"` //项目id
  Status int64 `json:"status"` //活动状态，是否在举办，默认关闭，需手动开启
  Pattern int64 `json:"pattern"` //方案: 0会员制，1公开制，2会员需授权
  MaxCount int64 `json:"maxCount"` //最大抽奖次数：-1表示无限制，0表示不可抽奖
  MaxPrizes int64 `json:"maxPrizes"` //最大抽奖次数：-1表示无限制，0表示不可中奖
  StartTime int64 `json:"startTime"` //活动开始时间
  EndTime int64 `json:"endTime"` //活动结束时间
}

//删除活动请求
type DelActivityReq {
  Id int64 `json:"id"` //活动 ID
}

//获取活动请求
type GetActivityReq {
  Id int64 `json:"id"` //活动 ID
}

//获取活动列表请求
type GetActivityListReq {
  PageSize int64 `form:"pageSize,optional,default=20"` //页面容量，默认20，可选
  Page int64 `form:"page,optional,default=1"` //当前页码，默认1，可选
  Current int64 `form:"current,optional,default=1"` //当前页码，默认1，用于对接umijs，可选
  Keyword string `form:"keyword,optional"` //关键词，可选
  Id int64 `form:"id,optional,default=-1"` //表主键
  Uuid string `form:"uuid,optional"` //UUID
  Name string `form:"name,optional"` //活动名称
  ProjectId int64 `form:"projectId,optional,default=-1"` //项目id
  Status int64 `form:"status,optional,default=-1"` //活动状态，是否在举办，默认关闭，需手动开启
  Pattern int64 `form:"pattern,optional,default=-1"` //方案: 0会员制，1公开制，2会员需授权
  MaxCount int64 `form:"maxCount,optional,default=-1"` //最大抽奖次数：-1表示无限制，0表示不可抽奖
  MaxPrizes int64 `form:"maxPrizes,optional,default=-1"` //最大抽奖次数：-1表示无限制，0表示不可中奖
  StartTime int64 `form:"startTime,optional,default=-1"` //活动开始时间
  EndTime int64 `form:"endTime,optional,default=-1"` //活动结束时间
}

//获取活动枚举请求
type GetActivityEnumsReq {
  ParentId int64 `json:"parentId,optional,default=-1"` //父级ID
}

// The content in this block will not be updated
// 此区块内的内容不会被更新
//[custom struct start]

type ActivityDetailReq {
  Id int64 `form:"id"`  //活动id
}

type projectActivitiesReq {
  ProjectId int64 `form:"projectId,optional,default=-1"`  //所属项目id，-1表示无限制
}

type UserActivitiesReq {
  UserId int64  `form:"userId,optional,default=-1"`  //所属用户id，-1表示无限制
}

type ActivityDetail {
  Activity Activity `json:"activity"`
  ActivityPrizes []ActivityPrize `json:"activityPrizes"`
}

type ActivityDetails {
  ActivityDetails []ActivityDetail `json:"ActivityDetails"`
}

type UserActivity {
  Activity      Activity       `json:"activity"`    //活动信息
  UserPool      UserPool       `json:"userPool"`  //活动用户池信息
}

//[custom struct end]

// ------------------------------ Struct End ------------------------------

@server(
  group: activity
  prefix: /v1/api/luckydraw/activity
)
service luckydraw {

  @doc "添加活动 基础API"
  @handler AddActivity
  post /(AddActivityReq) returns(BaseResp)

  @doc "更新活动 基础API"
  @handler PutActivity
  put /(PutActivityReq) returns(BaseResp)

  @doc "获取活动 基础API"
  @handler GetActivity
  get /(GetActivityReq) returns(BaseResp)

  @doc "删除活动 基础API"
  @handler DelActivity
  delete /(DelActivityReq) returns(BaseResp)

  @doc "获取活动列表 基础API"
  @handler GetActivityList
  get /list(GetActivityListReq) returns(BaseResp)

  @doc "获取活动枚举列表 基础API"
  @handler GetActivityEnums
  get /enums(GetActivityEnumsReq) returns(BaseResp)

}

// The content in this block will not be updated
// 此区块内的内容不会被更新
//[custom service start]

@server(
  group: activity
  prefix: /v1/api/luckydraw/activity
)
service luckydraw {
  @handler ActivityDetail
  get /detail(ActivityDetailReq) returns(BaseResp)

  @handler ActivityDetails
  post /details(GetActivityListReq) returns(BaseResp)

  @doc "指定项目的活动"
  @handler projectActivities
  get /projectActivities(projectActivitiesReq) returns(BaseResp)

  @doc "获取某用户参与的活动"
  @handler UserActivities
  get /userActivities(UserActivitiesReq) returns(BaseResp)

  @doc(
    summary: 获取活动模式枚举列表
  )
  @handler ActivityPatternEnumList
  get /patternEnumList returns(BaseResp)
}

//[custom service end]