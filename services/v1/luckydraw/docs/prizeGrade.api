@server(
  group: prizeGrade
  prefix: /v1/api/luckydraw/prizeGrade
)
service luckydraw {

  @doc "添加奖品级别 基础API"
  @handler AddPrizeGrade
  post /(AddPrizeGradeReq) returns(BaseResp)

  @doc "更新奖品级别 基础API"
  @handler PutPrizeGrade
  put /(PutPrizeGradeReq) returns(BaseResp)

  @doc "获取奖品级别 基础API"
  @handler GetPrizeGrade
  get /(GetPrizeGradeReq) returns(BaseResp)

  @doc "删除奖品级别 基础API"
  @handler DelPrizeGrade
  delete /(DelPrizeGradeReq) returns(BaseResp)

  @doc "获取奖品级别列表 基础API"
  @handler GetPrizeGradeList
  get /list(GetPrizeGradeListReq) returns(BaseResp)

  @doc "获取奖品级别枚举列表 基础API"
  @handler GetPrizeGradeEnums
  get /enums(GetPrizeGradeEnumsReq) returns(BaseResp)

}

