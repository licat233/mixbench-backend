//活动用户池，可以参与该活动抽奖的用户，及其在该活动中的积分管理
type UserPool {
  Id int64 `json:"id"` //表主键
  Uuid string `json:"uuid"` //UUID
  ActivityId int64 `json:"activityId"` //活动id
  UserId int64 `json:"userId"` //用户id
  Status int64 `json:"status"` //状态:0未授权，1正常，2已冻结
  Score int64 `json:"score"` //用户在当前活动的积分
}

//添加活动用户池，可以参与该活动抽奖的用户，及其在该活动中的积分管理请求
type AddUserPoolReq {
  ActivityId int64 `json:"activityId"` //活动id
  UserId int64 `json:"userId"` //用户id
  Status int64 `json:"status"` //状态:0未授权，1正常，2已冻结
  Score int64 `json:"score"` //用户在当前活动的积分
}

//更新活动用户池，可以参与该活动抽奖的用户，及其在该活动中的积分管理请求
type PutUserPoolReq {
  Id int64 `json:"id"` //表主键
  Uuid string `json:"uuid"` //UUID
  ActivityId int64 `json:"activityId"` //活动id
  UserId int64 `json:"userId"` //用户id
  Status int64 `json:"status"` //状态:0未授权，1正常，2已冻结
  Score int64 `json:"score"` //用户在当前活动的积分
}

//删除活动用户池，可以参与该活动抽奖的用户，及其在该活动中的积分管理请求
type DelUserPoolReq {
  Id int64 `json:"id"` //活动用户池，可以参与该活动抽奖的用户，及其在该活动中的积分管理 ID
}

//获取活动用户池，可以参与该活动抽奖的用户，及其在该活动中的积分管理请求
type GetUserPoolReq {
  Id int64 `form:"id"` //活动用户池，可以参与该活动抽奖的用户，及其在该活动中的积分管理 ID
}

//获取活动用户池，可以参与该活动抽奖的用户，及其在该活动中的积分管理列表请求
type GetUserPoolListReq {
  PageSize int64 `json:"pageSize,optional,default=20"` //页面容量，默认20，可选
