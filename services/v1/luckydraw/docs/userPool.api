@server(
  group: userPool
  prefix: /v1/api/luckydraw/userPool
)
service luckydraw {

  @doc "添加活动用户池，可以参与该活动抽奖的用户，及其在该活动中的积分管理 基础API"
  @handler AddUserPool
  post /(AddUserPoolReq) returns(BaseResp)

  @doc "更新活动用户池，可以参与该活动抽奖的用户，及其在该活动中的积分管理 基础API"
  @handler PutUserPool
  put /(PutUserPoolReq) returns(BaseResp)

  @doc "获取活动用户池，可以参与该活动抽奖的用户，及其在该活动中的积分管理 基础API"
  @handler GetUserPool
  get /(GetUserPoolReq) returns(BaseResp)

  @doc "删除活动用户池，可以参与该活动抽奖的用户，及其在该活动中的积分管理 基础API"
  @handler DelUserPool
  delete /(DelUserPoolReq) returns(BaseResp)

  @doc "获取活动用户池，可以参与该活动抽奖的用户，及其在该活动中的积分管理列表 基础API"
  @handler GetUserPoolList
  get /list(GetUserPoolListReq) returns(BaseResp)

  @doc "获取活动用户池，可以参与该活动抽奖的用户，及其在该活动中的积分管理枚举列表 基础API"
  @handler GetUserPoolEnums
  get /enums(GetUserPoolEnumsReq) returns(BaseResp)

}

