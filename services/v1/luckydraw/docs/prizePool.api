@server(
  group: prizePool
  prefix: /v1/api/luckydraw/prizePool
)
service luckydraw {

  @doc "添加活动奖品池，某活动中的奖品信息 基础API"
  @handler AddPrizePool
  post /(AddPrizePoolReq) returns(BaseResp)

  @doc "更新活动奖品池，某活动中的奖品信息 基础API"
  @handler PutPrizePool
  put /(PutPrizePoolReq) returns(BaseResp)

  @doc "获取活动奖品池，某活动中的奖品信息 基础API"
  @handler GetPrizePool
  get /(GetPrizePoolReq) returns(BaseResp)

  @doc "删除活动奖品池，某活动中的奖品信息 基础API"
  @handler DelPrizePool
  delete /(DelPrizePoolReq) returns(BaseResp)

  @doc "获取活动奖品池，某活动中的奖品信息列表 基础API"
  @handler GetPrizePoolList
  get /list(GetPrizePoolListReq) returns(BaseResp)

  @doc "获取活动奖品池，某活动中的奖品信息枚举列表 基础API"
  @handler GetPrizePoolEnums
  get /enums(GetPrizePoolEnumsReq) returns(BaseResp)

}

// The content in this block will not be updated
// 此区块内的内容不会被更新
//[custom service start]

@server(
  group: prizePool
  prefix: /v1/api/luckydraw/prizePool
)
service luckydraw {
  @doc "重置某活动的奖品池概率"
  @handler ResetLuckValue
  post /resetLuckValue(ResetLuckValueReq) returns(BaseResp)
}

//[custom service end]