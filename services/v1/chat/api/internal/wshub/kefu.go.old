package wshub

import (
	"context"
	"encoding/json"
	"errors"
	"fmt"
	"mixbench/common/uniqueid"
	"mixbench/services/v1/chat/api/internal/logic/dataconv"
	"mixbench/services/v1/chat/api/internal/types"
	"mixbench/services/v1/chat/model"
	"net/http"
	"sync"
	"time"

	"github.com/gorilla/websocket"
	"github.com/zeromicro/go-zero/core/logx"
)

type KefuClient struct {
	*Client
	Kefu *model.Kefu
}

// 新建客服client，如果初始化失败，会返回 nil, nil
func NewKefuClient(ctx context.Context, hub *Hub, w http.ResponseWriter, r *http.Request) (*KefuClient, error) {
	if hub == nil {
		return nil, errors.New("hub is nil")
	}
	var isOk = false
	conn, err := NewWsConn(w, r)
	if err != nil {
		return nil, fmt.Errorf("newWsConn error: %s", err)
	}
	defer func() {
		if !isOk {
			if conn != nil {
				conn.Close()
			}
			// CloseWsConn(conn)
		}
	}()
	c := &KefuClient{
		Client: &Client{
			Logger:    logx.WithContext(ctx),
			ctx:       ctx,
			hub:       hub,
			conn:      conn,
			send:      make(chan *model.Message, 20),
			Stop:      make(chan bool),
			Status:    true,
			ProjectId: 0,
			w:         w,
			r:         r,
		},
		Kefu: nil,
	}
	// 鉴权
	ok, id, err := c.Identify()
	if err != nil {
		return nil, fmt.Errorf("token identify error: %v", err)
	}
	if !ok {
		return nil, nil
	}

	//查找是否存在该客服
	kefu, err := c.hub.SvcCtx.KefuModel.FindById(c.ctx, id)
	if err != nil && err != model.ErrNotFound {
		c.Logger.Error(err)
		return nil, err
	}

	if err == model.ErrNotFound || kefu == nil {
		return nil, nil
	}

	//查找是否存在该项目
	_, err = c.hub.SvcCtx.ProjectModel.FindById(c.ctx, kefu.ProjectId)
	if err != nil && err != model.ErrNotFound {
		c.Logger.Error(err)
		return nil, err
	}
	if err == model.ErrNotFound {
		return nil, nil
	}

	c.Kefu = kefu
	c.Client.ProjectId = kefu.ProjectId

	// 注册
	hub.KefuClients.Set(c)

	//更新数据库中的数据为在线状态
	kefu.Status = 1
	err = c.hub.SvcCtx.KefuModel.Update(c.ctx, kefu)
	if err != nil {
		c.Logger.Error(err)
		return nil, err
	}

	// 此时，可能存在需要接待的游客
	vclis := hub.VisitorClients.GetByKefuId(-1)
	for _, v := range vclis {
		err = hub.TransferVisitor(v.Visitor.Id, kefu.Id)
		if err != nil {
			return nil, err
		}
	}
	isOk = true
	return c, nil
}

func (c *KefuClient) Run() (err error) {
	var WritePumpError, ReadPumpError error
	var wg sync.WaitGroup
	// 开始收发ws信息
	wg.Add(1)
	go func() {
		defer wg.Done()
		WritePumpError = c.WritePump()
	}()
	wg.Add(1)
	go func() {
		defer wg.Done()
		ReadPumpError = c.ReadPump()
	}()
	wg.Wait()
	if WritePumpError != nil {
		err = fmt.Errorf("WritePumpError: %s", WritePumpError)
		return err
	}
	if ReadPumpError != nil {
		err = fmt.Errorf("%s + ReadPumpError: %s", err, ReadPumpError)
		return err
	}
	return
}

// 读取客服通过ws发送过来的信息
func (c *KefuClient) ReadPump() (e error) {
	defer func() {
		if err := c.Logout(); e == nil {
			e = err
		}
	}()

	for {
		select {
		case <-c.Stop:
			return nil
		default:
			_, messageBody, err := c.conn.ReadMessage()
			if err != nil {
				return nil
			}
			// messageBody 为一个完整的 message 的 json 数据
			var message model.Message
			if err = json.Unmarshal(messageBody, &message); err != nil {
				// 不符合规范的 messageBody，丢弃
				continue
			}
			if message.VisitorId <= 1 {
				c.Logger.Error("unvalidtor visitor id: %d", message.VisitorId)
				continue
			}

			message.Uuid = uniqueid.NewUUID()
			message.KefuId = c.Kefu.Id
			message.MsgType = 1
			message.ProjectId = c.ProjectId
			message.SendTime = time.Now().Local()

			//通道方案：
			// 入栈前，持久化一下，防止消息在通道中意外丢失
			if err := c.hub.SendBeforeHandler(&message); err != nil {
				c.Client.SystemErrorHandler(c.Kefu.Id, -1)
				e = fmt.Errorf("SendBeforeHandler error: %s", err)
				return
			}

			c.hub.MessageStore <- &message

			//改用消息队列方案：
		}
	}
}

// 给客服的ws写入消息
func (c *KefuClient) WritePump() (e error) {
	ticker := time.NewTicker(pingPeriod)
	defer func() {
		ticker.Stop()
		if err := c.Logout(); e == nil {
			e = err
		}
	}()

	//发送公告信息
	if err := c.Client.SendPresetMessage(PublicMessageKey, c.Kefu.Id, -1); err != nil {
		c.Logger.Error(err)
		e = fmt.Errorf("send public message error: %s", err)
		return
	}

	//已经准备好接收信息了，那就把缓存的消息全部发送给该客服
	mdMsgList, err := c.hub.SvcCtx.MessageModel.FindsToKefuByKefuId(c.ctx, c.Kefu.Id)
	if err != nil {
		c.Logger.Error(err)
		e = err
		return
	}
	msgList := dataconv.MdMessages2ApiMessages(mdMsgList)
	for _, msg := range msgList {
		if err := c.WriteMessage(msg); err != nil {
			e = err
			return
		}
	}

	for {
		select {
		case message, ok := <-c.send:
			if !ok {
				// The hub closed the channel.
				if err := c.conn.WriteMessage(websocket.CloseMessage, []byte{}); err != nil {
					if websocket.IsUnexpectedCloseError(err, websocket.CloseNormalClosure, websocket.CloseGoingAway) {
						//正常关闭
						return nil
					} else {
						//异常关闭
						c.Logger.Error("websocket conn IsUnexpectedCloseError: %v", err)
						return fmt.Errorf("websocket conn IsUnexpectedCloseError: %v", err)
					}
				}
				// 已关闭，正常退出
				return nil
			}
			if err := c.WriteMessage(dataconv.MdMessageToApiMessage(message)); err != nil {
				e = err
				return
			}
		case <-c.Stop:
			//关闭了
			return nil
		case <-ticker.C:
			c.conn.SetWriteDeadline(time.Now().Add(writeWait))
			if err := c.conn.WriteMessage(websocket.PingMessage, nil); err != nil {
				c.Logger.Error(err)
				e = fmt.Errorf("conn.WriteMessage error: %s", err)
				return
			}
		}
	}
}

func (c *KefuClient) WriteMessage(message *types.Message) error {
	body, _ := json.Marshal(*message)
	if err := c.conn.WriteMessage(websocket.TextMessage, body); err != nil {
		c.Logger.Error(err)
		return fmt.Errorf("conn.WriteMessage error: %s", err)
	}
	if err := c.hub.SendAfterHandler(message); err != nil {
		c.Logger.Error(err)
		return fmt.Errorf("SendAfterHandler error: %s", err)
	}
	return nil
}

func (c *KefuClient) Logout() error {
	if !c.Client.Status {
		return nil
	}
	c.Client.Status = false
	c.hub.KefuClients.Del(c.Kefu.Id)
	//更新数据库中的数据为离线状态
	c.Kefu.Status = 0
	err := c.hub.SvcCtx.KefuModel.Update(c.ctx, c.Kefu)
	if err != nil {
		c.Logger.Error(err)
		return err
	}
	//此时，如果其对接的游客还在线，应该将他的游客转接给其它客服，而不是放任不管
	//逻辑：转移当前客服的在线游客，分配给其它客服
	vclis := c.hub.VisitorClients.GetByKefuId(c.Kefu.Id)
	for _, vcli := range vclis {
		kcli := c.hub.AssignKefu(c.ProjectId)
		if kcli == nil {
			//如果没有客服可分配，则无法分配，无需分配
			break
		}
		if err := c.hub.TransferVisitor(vcli.Visitor.Id, kcli.Kefu.Id); err != nil {
			return err
		}
	}
	return nil
}

func (c *KefuClient) NewMessage(content string, visitorId int64) *model.Message {
	return &model.Message{
		Id:          0,
		Uuid:        uniqueid.NewUUID(),
		Content:     content,
		ContentType: TextContentType,
		VisitorId:   visitorId,
		KefuId:      c.Kefu.Id,
		MsgType:     KefuMsgType, //目前仅支持普通文本的消息
		Status:      0,
		IsRead:      0,
		IsSend:      0,
		SendTime:    time.Now().Local(),
	}
}

type kefuClientMap struct {
	Map     map[int64]*KefuClient
	RwMutex *sync.RWMutex
}

func newKefuClientMap() *kefuClientMap {
	return &kefuClientMap{
		Map:     map[int64]*KefuClient{},
		RwMutex: &sync.RWMutex{},
	}
}

func (l *kefuClientMap) Ids() []int64 {
	l.RwMutex.RLock()
	defer l.RwMutex.RUnlock()
	var res []int64
	for i := range l.Map {
		res = append(res, i)
	}
	return res
}

func (l *kefuClientMap) Set(vc *KefuClient) {
	if vc == nil {
		return
	}
	l.RwMutex.Lock()
	defer l.RwMutex.Unlock()
	l.Map[vc.Kefu.Id] = vc
}

func (l *kefuClientMap) Del(id int64) {
	l.RwMutex.Lock()
	defer l.RwMutex.Unlock()
	if v, ok := l.Map[id]; ok {
		v.Close()
		delete(l.Map, id)
	}
}

func (l *kefuClientMap) Get(id int64) *KefuClient {
	l.RwMutex.RLock()
	defer l.RwMutex.RUnlock()
	return l.Map[id]
}

func (l *kefuClientMap) Len() int {
	l.RwMutex.RLock()
	defer l.RwMutex.RUnlock()
	return len(l.Map)
}
