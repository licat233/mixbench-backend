//[custom service start]

@server(
  prefix: /v1/api/chat
)
service chat {
  @doc "游客登录"
  @handler VisitorLogin
  post /visitorLogin(VisitorLoginReq) returns(BaseResp)

  @doc "客服登录"
  @handler KefuLogin
  post /kefuLogin(KefuLoginReq) returns(BaseResp)

  @doc "测试"
  @handler Test
  get /test(TestReq) returns(BaseResp)
}

@server(
  middleware: VisitorAuth
  prefix: /v1/api/chat/ws
)
service chat {
  @doc "visitor建立ws连接"
  @handler VisitorServer
  get /visitor
}

@server(
  auth: Auth
  prefix: /v1/api/chat/ws
)
service chat {
  @doc "kefu建立ws连接"
  @handler KefuServer
  get /kefu
}

@server(
  auth: Auth
  prefix: /v1/api/chat
)
service chat {
  @doc "保存消息配置"
  @handler SaveMsgConf
  post /saveMsgConf(SaveMsgConfReq) returns(BaseResp)

  @doc "获取某客服的游客列表"
  @handler VisitorList
  post /visitorList(VisitorListReq) returns(BaseResp)

  @doc "将游客转接给其他客服"
  @handler TransferVisitor
  post /transferVisitor(transferVisitorReq) returns(BaseResp)
}

//[custom service end]