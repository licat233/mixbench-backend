// 游客登录请求
type VisitorLoginReq {
}

type KefuLoginReq {
  Passport  string `json:"passport"`
  Password  string `json:"password"`
  AutoLogin bool   `json:"autoLogin,default=false"`
  CaptchaId string `json:"captchaId"` //验证码ID
  Solution  string `json:"solution"`  //验证码答案
}

type MsgConfItem {
  Id        int64  `json:"id"`
  ConfValue string `json:"confValue"`
}

type SaveMsgConfReq {
  ConfData []MsgConfItem `json:"confData"`
}

type TestReq {
  Data string `json:"data,optional"`
}

type VisitorListReq {
  PageSize int64  `form:"pageSize,optional,default=20"` //页面容量，默认20，可选
  Page     int64  `form:"page,optional,default=1"`      //当前页码，默认1，可选
  Current  int64  `form:"current,optional,default=1"`   //当前页码，默认1，用于对接umijs，可选
  Keyword  string `form:"keyword,optional"`             //关键词，可选
}

type transferVisitorReq {
  VisitorId int64 `json:"visitorId,optional"` //转移的游客id
  KefuId    int64 `json:"kefuId,optional"`    //接待游客的客服id
}

