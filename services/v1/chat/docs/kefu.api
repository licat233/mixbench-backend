@server(
  group: kefu
  prefix: /v1/api/chat/kefu
)
service chat {

  @doc "添加客服 基础API"
  @handler AddKefu
  post /(AddKefuReq) returns(BaseResp)

  @doc "更新客服 基础API"
  @handler PutKefu
  put /(PutKefuReq) returns(BaseResp)

  @doc "获取客服 基础API"
  @handler GetKefu
  get /(GetKefuReq) returns(BaseResp)

  @doc "删除客服 基础API"
  @handler DelKefu
  delete /(DelKefuReq) returns(BaseResp)

  @doc "获取客服列表 基础API"
  @handler GetKefuList
  get /list(GetKefuListReq) returns(BaseResp)

  @doc "获取客服枚举列表 基础API"
  @handler GetKefuEnums
  get /enums(GetKefuEnumsReq) returns(BaseResp)

}

