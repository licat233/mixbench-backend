@server(
  group: message
  prefix: /v1/api/chat/message
)
service chat {

  @doc "添加消息 基础API"
  @handler AddMessage
  post /(AddMessageReq) returns(BaseResp)

  @doc "更新消息 基础API"
  @handler PutMessage
  put /(PutMessageReq) returns(BaseResp)

  @doc "获取消息 基础API"
  @handler GetMessage
  get /(GetMessageReq) returns(BaseResp)

  @doc "删除消息 基础API"
  @handler DelMessage
  delete /(DelMessageReq) returns(BaseResp)

  @doc "获取消息列表 基础API"
  @handler GetMessageList
  get /list(GetMessageListReq) returns(BaseResp)

  @doc "获取消息枚举列表 基础API"
  @handler GetMessageEnums
  get /enums(GetMessageEnumsReq) returns(BaseResp)

}

