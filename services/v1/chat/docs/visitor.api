@server(
  group: visitor
  prefix: /v1/api/chat/visitor
)
service chat {

  @doc "添加游客 基础API"
  @handler AddVisitor
  post /(AddVisitorReq) returns(BaseResp)

  @doc "更新游客 基础API"
  @handler PutVisitor
  put /(PutVisitorReq) returns(BaseResp)

  @doc "获取游客 基础API"
  @handler GetVisitor
  get /(GetVisitorReq) returns(BaseResp)

  @doc "删除游客 基础API"
  @handler DelVisitor
  delete /(DelVisitorReq) returns(BaseResp)

  @doc "获取游客列表 基础API"
  @handler GetVisitorList
  get /list(GetVisitorListReq) returns(BaseResp)

  @doc "获取游客枚举列表 基础API"
  @handler GetVisitorEnums
  get /enums(GetVisitorEnumsReq) returns(BaseResp)

}

