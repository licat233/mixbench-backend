@server(
  group: chatRecord
  prefix: /v1/api/chat/chatRecord
)
service chat {

  @doc "添加聊天记录 基础API"
  @handler AddChatRecord
  post /(AddChatRecordReq) returns(BaseResp)

  @doc "更新聊天记录 基础API"
  @handler PutChatRecord
  put /(PutChatRecordReq) returns(BaseResp)

  @doc "获取聊天记录 基础API"
  @handler GetChatRecord
  get /(GetChatRecordReq) returns(BaseResp)

  @doc "删除聊天记录 基础API"
  @handler DelChatRecord
  delete /(DelChatRecordReq) returns(BaseResp)

  @doc "获取聊天记录列表 基础API"
  @handler GetChatRecordList
  get /list(GetChatRecordListReq) returns(BaseResp)

  @doc "获取聊天记录枚举列表 基础API"
  @handler GetChatRecordEnums
  get /enums(GetChatRecordEnumsReq) returns(BaseResp)

}

