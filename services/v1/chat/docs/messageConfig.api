@server(
  group: messageConfig
  prefix: /v1/api/chat/messageConfig
)
service chat {

  @doc "添加消息配置 基础API"
  @handler AddMessageConfig
  post /(AddMessageConfigReq) returns(BaseResp)

  @doc "更新消息配置 基础API"
  @handler PutMessageConfig
  put /(PutMessageConfigReq) returns(BaseResp)

  @doc "获取消息配置 基础API"
  @handler GetMessageConfig
  get /(GetMessageConfigReq) returns(BaseResp)

  @doc "删除消息配置 基础API"
  @handler DelMessageConfig
  delete /(DelMessageConfigReq) returns(BaseResp)

  @doc "获取消息配置列表 基础API"
  @handler GetMessageConfigList
  get /list(GetMessageConfigListReq) returns(BaseResp)

  @doc "获取消息配置枚举列表 基础API"
  @handler GetMessageConfigEnums
  get /enums(GetMessageConfigEnumsReq) returns(BaseResp)

}

